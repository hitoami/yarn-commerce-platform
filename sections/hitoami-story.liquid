{% comment %}
  首页品牌介绍:品牌图 + 小标题 + 品牌标语 + 品牌故事,下方附一张 LINE 卡片(#131,取代首页底部的 LINE 帮助条)。
  手机上下排列(图 → 文字 → LINE 卡片);桌面左图右文。品牌图优先用上传素材，也可启用本轮生成的编织与猫氛围图；两者都没有时不渲染媒体。
  有 LINE 链接时桌面与手机同一行（#292 方案 A，无箭头）：图标 + 添加好友 + 说明；桌面右侧直接显示二维码，手机用原生 details 展开。
  LINE 链接留空时回退为联系页卡片。
  三语文案经 yarn-setting-text 取:纯键名为日文默认,_zh/_en 为中英设置。
{% endcomment %}
{{ 'hitoami-story.css' | asset_url | stylesheet_tag }}
{%- capture story_heading -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'story_heading' -%}{%- endcapture -%}
{%- capture story_text -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'story_text' -%}{%- endcapture -%}
{%- capture line_heading -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'line_heading' -%}{%- endcapture -%}
{%- capture line_text -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'line_text' -%}{%- endcapture -%}
{%- capture line_cta -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'line_cta' -%}{%- endcapture -%}
{%- if story_heading != blank or story_text != blank -%}
<div class="hitoami-story" {% if story_heading != blank %}aria-labelledby="HitoamiStory-{{ section.id }}"{% endif %}>
  {% if section.settings.image != blank or section.settings.use_brand_scene %}<div class="hitoami-story__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 46vw, calc(100vw - 32px)', loading: 'lazy', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {%- comment -%}#189：原 PNG 2.6 MB，改为 768 / 1536 WebP（58 / 151 KB）按显示宽度选。{%- endcomment -%}
      <img src="{{ 'hitoami-brand-knitting-cat-768.webp' | asset_url }}" srcset="{{ 'hitoami-brand-knitting-cat-768.webp' | asset_url }} 768w, {{ 'hitoami-brand-knitting-cat-1536.webp' | asset_url }} 1536w" sizes="(min-width: 750px) 46vw, calc(100vw - 32px)" width="1536" height="1024" loading="lazy" decoding="async" alt="">
    {%- endif -%}
  </div>
  {% endif %}<div class="hitoami-story__body">
    {%- if story_heading != blank -%}<h2 id="HitoamiStory-{{ section.id }}">{{ story_heading | escape | newline_to_br }}</h2>{%- endif -%}
    {%- if story_text != blank -%}<div class="rte">{{ story_text }}</div>{%- endif -%}
    {%- if line_cta != blank -%}
      {%- assign line_href = section.settings.line_link | default: pages.contact.url -%}
      {% if section.settings.line_link == blank %}{% capture line_cta %}{% render 'yarn-setting-text', settings: section.settings, key: 'line_fallback' %}{% endcapture %}{% endif %}
      {%- if section.settings.line_link != blank -%}
        {%- assign has_line_qr = false -%}
        {%- if section.settings.line_qr != blank or section.settings.line_link == 'https://lin.ee/p5xrDGo' -%}{%- assign has_line_qr = true -%}{%- endif -%}
        {%- assign line_qr_alt = 'accessibility.line_qr_alt' | t -%}
        {%- capture line_qr_image -%}
          {%- if section.settings.line_qr != blank -%}
            {{ section.settings.line_qr | image_url: width: 480 | image_tag: class: 'hitoami-story__qr-image', loading: 'lazy', alt: line_qr_alt }}
          {%- else -%}
            <img class="hitoami-story__qr-image" src="{{ 'hitoami-line-qr.png' | asset_url }}" width="184" height="194" loading="lazy" alt="{{ line_qr_alt | escape }}">
          {%- endif -%}
        {%- endcapture -%}
        <div class="hitoami-story__line-row">
          <a class="hitoami-story__line-link" href="{{ line_href | escape }}" target="_blank" rel="noopener">
            <img class="hitoami-story__line-icon" src="{{ 'line-brand-icon.png' | asset_url }}" width="40" height="40" loading="lazy" alt="">
            <span class="hitoami-story__line-label">
              <span class="hitoami-story__line-name">{{ line_cta | escape }}</span>
              {%- if line_text != blank -%}<span class="hitoami-story__line-sub">{{ line_text | escape }}</span>{%- endif -%}
            </span>
          </a>
          {%- if has_line_qr -%}
            <figure class="hitoami-story__line-qr">
              <span class="hitoami-story__line-qr-frame">{{ line_qr_image }}</span>
              <figcaption>{{ 'accessibility.scan_line_qr' | t }}</figcaption>
            </figure>
            <details class="hitoami-story__line-details">
              <summary>
                <span class="hitoami-story__qr-show">{{ 'accessibility.show_line_qr' | t }}</span>
                <span class="hitoami-story__qr-hide">{{ 'accessibility.hide_line_qr' | t }}</span>
                <span class="hitoami-story__qr-chevron" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              </summary>
              {{ line_qr_image }}
            </details>
          {%- endif -%}
        </div>
      {%- else -%}
      <div class="hitoami-story__line">
        {%- if section.settings.line_qr != blank -%}
          <div class="hitoami-story__qr">{{ section.settings.line_qr | image_url: width: 240 | image_tag: width: 96, height: 96, loading: 'lazy', alt: '' }}</div>
        {%- endif -%}
        <div class="hitoami-story__line-copy">
          {%- if line_heading != blank -%}<p class="hitoami-story__line-title">{{ line_heading | escape }}</p>{%- endif -%}
          {%- if line_text != blank -%}<p class="hitoami-story__line-text">{{ line_text | escape }}</p>{%- endif -%}
        </div>
        <a class="hitoami-story__line-cta" href="{{ line_href }}">{{ line_cta | escape }}</a>
      </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "品牌介绍",
  "tag": "section",
  "class": "section hitoami-story-section",
  "settings": [{"type":"checkbox","id":"use_brand_scene","label":"使用编织与猫的品牌氛围图","default":false},{"type":"text","id":"line_fallback","label":"未配置 LINE · 日文","default":"毛糸選びについてお問い合わせ"},{"type":"text","id":"line_fallback_zh","label":"未配置 LINE · 中文","default":"选线遇到问题？联系我们"},{"type":"text","id":"line_fallback_en","label":"未配置 LINE · 英文","default":"Need help choosing yarn? Contact us"},
    { "type": "image_picker", "id": "image", "label": "品牌图", "info": "上传图优先；未上传时可启用本轮品牌氛围图。" },
    {
      "type": "textarea",
      "id": "story_heading",
      "label": "日文 · 品牌标语",
      "default": "最初のひと目から、\n編みもので、人と暮らしをやさしくつなぐ。"
    },
    {
      "type": "textarea",
      "id": "story_heading_zh",
      "label": "中文 · 品牌标语",
      "default": "从第一针开始，\n用编织，温柔连接人与生活。"
    },
    {
      "type": "textarea",
      "id": "story_heading_en",
      "label": "英文 · 品牌标语",
      "default": "From the first stitch,\nweaving warmth into everyday connections."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "日文 · 品牌故事",
      "default": "<p>hitoami は、「一」と「編む」という想いから生まれました。</p><p>最初のひと目から、糸と色、ひらめきを少しずつ暮らしの中へ。初めて毛糸に触れる人も、手づくりが好きな人も。ひと目ひと目に自分のペースを見つけ、編みものを愛する誰かと出会える場所でありたいと願っています。</p>"
    },
    {
      "type": "richtext",
      "id": "story_text_zh",
      "label": "中文 · 品牌故事",
      "default": "<p>hitoami，取意于「一」与「编织」。</p><p>从第一针开始，把线、色彩与灵感慢慢编进日常。无论初次拿起毛线，还是早已钟情手作，都能在一针一线之间找到自己的节奏，也与同样热爱编织的人相遇。</p>"
    },
    {
      "type": "richtext",
      "id": "story_text_en",
      "label": "英文 · 品牌故事",
      "default": "<p>hitoami brings together the ideas of “one” and “knitting”.</p><p>From the first stitch, bring yarn, colour and imagination into everyday life. Whether you are picking up yarn for the first time or have always loved making, find your own rhythm, one stitch at a time—and connect with others who share that love.</p>"
    },
    { "type": "header", "content": "LINE 卡片" },
    { "type": "url", "id": "line_link", "label": "LINE 链接", "info": "官方 LINE 加好友链接；留空时按钮链到联系页。" },
    { "type": "image_picker", "id": "line_qr", "label": "LINE 二维码", "info": "桌面直接显示，手机点击展开。留空且链接为当前 hitoami 账号时，手机使用随主题提供的二维码；更换账号请同时上传对应二维码。" },
    { "type": "text", "id": "line_heading", "label": "日文 · LINE 标题", "default": "hitoami 公式 LINE" },
    { "type": "text", "id": "line_heading_zh", "label": "中文 · LINE 标题", "default": "hitoami 官方 LINE" },
    { "type": "text", "id": "line_heading_en", "label": "英文 · LINE 标题", "default": "hitoami on LINE" },
    { "type": "text", "id": "line_text", "label": "日文 · LINE 说明", "default": "糸選び、必要な量、作り方の受け取りまで、気軽にどうぞ。" },
    { "type": "text", "id": "line_text_zh", "label": "中文 · LINE 说明", "default": "选线、算用量、领取教程，都可以问我们。" },
    { "type": "text", "id": "line_text_en", "label": "英文 · LINE 说明", "default": "Ask us about yarn, amounts and getting your pattern." },
    { "type": "text", "id": "line_cta", "label": "日文 · LINE 按钮", "default": "LINE で友だち追加" },
    { "type": "text", "id": "line_cta_zh", "label": "中文 · LINE 按钮", "default": "添加 LINE 好友" },
    { "type": "text", "id": "line_cta_en", "label": "英文 · LINE 按钮", "default": "Add us on LINE" }
  ],
  "presets": [
    {
      "name": "品牌介绍"
    }
  ]
}
{% endschema %}
