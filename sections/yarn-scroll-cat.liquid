{% comment %}
  首页桌面滚动进度：屏幕底边一只小猫推着毛线球，随页面滚动从左走到右，线球放出的毛线从左边一直铺到线球下，长度即进度。
  毛线与线球的颜色、形状跟 Logo 一致（home-logo；实心线球 + 奶油色缝隙的三组缠绕线）。
  停止滚动时坐下、再趴下睡觉；往回滚时转身；到页尾在线球旁睡着。只在桌面（≥990px）显示；减少动态时不播走路帧。
  复用导览条的九帧小猫精灵图（yarn-guide-cat.webp）。纯装饰，不可交互、不进读屏。
{% endcomment %}
{{ 'yarn-scroll-cat.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-scroll-cat.js' | asset_url }}" defer="defer"></script>

<yarn-scroll-cat class="yarn-scroll-cat" aria-hidden="true">
  <svg class="yarn-scroll-cat__thread" preserveAspectRatio="none" focusable="false"><path/></svg>
  <span class="yarn-scroll-cat__cat" style="background-image: url('{{ 'yarn-guide-cat.webp' | asset_url }}');"></span>
  {%- comment -%} Same drawing as the logo's ball: a solid disc with cream gaps between three wrap bands. {%- endcomment -%}
  <svg class="yarn-scroll-cat__ball" viewBox="-11 -11 22 22" focusable="false">
    <circle r="10"/>
    <path d="M-9.9 -.6Q-8 -6 -3.4 -9.3M-9.2 3.2Q-6.5 -4.5 1.2 -9.6M-7.6 6.3Q-4.2 -2.6 5.2 -8.4M-5.2 8.4Q-1.6 0 8.4 -5.4M-1.6 2.6Q3.6 .4 9.9 1.4M-.6 5.4Q4.2 3.6 8.8 4.9M1.2 4.4Q1.4 7.4 .6 9.9M4.2 4.7Q4.8 7.2 4.4 9"/>
  </svg>
</yarn-scroll-cat>

{% schema %}
{
  "name": "滚动进度小猫",
  "tag": "div",
  "class": "section-yarn-scroll-cat",
  "settings": [],
  "presets": [{ "name": "滚动进度小猫" }]
}
{% endschema %}
