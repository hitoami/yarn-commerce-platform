{{ 'yarn-cards.css' | asset_url | stylesheet_tag }}
{% comment %}
  首页「用我们的毛线可以织」:运营挑选的 yarn_project 材料包卡(未挑选时按作品库顺序),点击进入作品页选色与购买毛线。
  只显示通过 yarn-kit-visible 的作品;一件都没有时整块不渲染。
  三语文案经 yarn-setting-text 取:纯键名为日文默认,_zh/_en 为中英设置。
{% endcomment %}
{%- capture pp_heading -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'heading' -%}{%- endcapture -%}
{%- capture pp_note -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'note', allow_blank: true -%}{%- endcapture -%}
{%- assign pp_guided = false -%}
{%- if request.page_type == 'index' -%}{%- assign pp_guided = true -%}{%- endif -%}
{%- capture pp_steps -%}
  {%- if pp_guided -%}
    {%- for step in (1..3) -%}
      {%- assign step_key = 'step_' | append: step -%}
      {%- capture step_text -%}{%- render 'yarn-setting-text', settings: section.settings, key: step_key, allow_blank: true -%}{%- endcapture -%}
      {%- if step_text != blank -%}<li class="yx-picks__step"><span class="yx-picks__number">{{ step }}</span>{{ step_text | escape }}</li>{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture pp_cards -%}
  {%- assign pp_shown = 0 -%}
  {%- assign pp_projects = section.settings.projects -%}
  {%- if pp_projects.size == 0 -%}{%- assign pp_projects = shop.metaobjects.yarn_project.values -%}{%- endif -%}
  {%- for project in pp_projects -%}
    {%- if pp_shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- capture pp_visible -%}{%- render 'yarn-kit-visible', project: project -%}{%- endcapture -%}
    {%- if pp_visible == 'true' and project.cover.value != blank -%}
      {%- assign pp_shown = pp_shown | plus: 1 -%}
      {%- render 'yarn-project-pick-card', project: project, show_steps: pp_guided -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if pp_cards contains 'yx-project-pick' -%}
<section class="yx-picks{% if pp_guided %} yx-picks--guided{% endif %} yarn-shell-block color-{{ section.settings.color_scheme }}" aria-labelledby="ProjectPicks-{{ section.id }}">
  <div class="yx-picks__inner page-width">
    <div class="yx-picks__head">
      <div class="yx-picks__titles">
        <h2 id="ProjectPicks-{{ section.id }}">{{ pp_heading | escape }}</h2>
        {%- if pp_note != blank -%}<p class="yx-picks__note">{{ pp_note | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.all_link != blank -%}<a class="yx-picks__all" href="{% render 'yarn-local-url', url: section.settings.all_link %}">{{ 'yarn_project.card_view_all' | t }} →</a>{%- endif -%}
    </div>
    {%- if pp_steps != blank -%}<ol class="yx-picks__steps" role="list">{{ pp_steps }}</ol>{%- endif -%}
    <div class="yx-project-picks">{{ pp_cards }}</div>
  </div>
</section>
{%- elsif request.design_mode -%}
  <p class="yx-picks__note page-width">{{ pp_heading | escape }}：请在右侧选择已公开且有封面的作品，没有可显示的作品时本区块不在店面显示。</p>
{%- endif -%}

{% schema %}
{
  "name": "按作品图选",
  "settings": [
    { "type": "text", "id": "heading", "label": "日文 · 标题", "default": "作品から選ぶ" },
    { "type": "text", "id": "heading_zh", "label": "中文 · 标题", "default": "按作品图选" },
    { "type": "text", "id": "heading_en", "label": "英文 · 标题", "default": "Shop by project" },
    { "type": "text", "id": "note", "label": "日文 · 辅助说明(可空)", "default": "はじめての方も、3ステップでスタート。" },
    { "type": "text", "id": "note_zh", "label": "中文 · 辅助说明(可空)", "default": "第一次来？三步就能开始。" },
    { "type": "text", "id": "note_en", "label": "英文 · 辅助说明(可空)", "default": "New here? Get started in three steps." },
    {"type": "text", "id": "step_1", "label": "日文 · 第 1 步(可空)", "default": "作品を選ぶ"},
    {"type": "text", "id": "step_1_zh", "label": "中文 · 第 1 步(可空)", "default": "选作品"},
    {"type": "text", "id": "step_1_en", "label": "英文 · 第 1 步(可空)", "default": "Pick a project"},
    {"type": "text", "id": "step_2", "label": "日文 · 第 2 步(可空)", "default": "毛糸をまとめて購入"},
    {"type": "text", "id": "step_2_zh", "label": "中文 · 第 2 步(可空)", "default": "一次买齐毛线"},
    {"type": "text", "id": "step_2_en", "label": "英文 · 第 2 步(可空)", "default": "Buy all the yarn"},
    {"type": "text", "id": "step_3", "label": "日文 · 第 3 步(可空)", "default": "LINEで編み方を受け取る"},
    {"type": "text", "id": "step_3_zh", "label": "中文 · 第 3 步(可空)", "default": "LINE 领教程"},
    {"type": "text", "id": "step_3_en", "label": "英文 · 第 3 步(可空)", "default": "Get a LINE tutorial"},
    { "type": "metaobject_list", "id": "projects", "label": "作品及顺序", "metaobject_type": "yarn_project", "limit": 8 },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "default": 4, "label": "最多显示" },
    { "type": "url", "id": "all_link", "label": "查看全部链接(可空)" },
    { "type": "select", "id": "color_scheme", "label": "配色", "options": [ { "value": "scheme-1", "label": "默认" } ], "default": "scheme-1" }
  ],
  "presets": [ { "name": "按作品图选" } ]
}
{% endschema %}
