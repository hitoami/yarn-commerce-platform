{% liquid
  assign line_has_primary = false
  if section.settings.primary_link != blank
    assign line_has_primary = true
  endif
  capture line_heading
    render 'yarn-setting-text', settings: section.settings, key: 'heading'
  endcapture
  capture line_text
    render 'yarn-setting-text', settings: section.settings, key: 'text'
  endcapture
  capture line_primary
    render 'yarn-setting-text', settings: section.settings, key: 'primary_label', zh: 'primary_zh', en: 'primary_en'
  endcapture
  capture line_secondary
    render 'yarn-setting-text', settings: section.settings, key: 'secondary_label', zh: 'secondary_zh', en: 'secondary_en'
  endcapture

  unless line_has_primary
    capture line_heading
      render 'yarn-setting-text', settings: section.settings, key: 'fallback_heading', zh: 'heading_zh_fallback', en: 'heading_en_fallback'
    endcapture
    capture line_text
      render 'yarn-setting-text', settings: section.settings, key: 'fallback_text', zh: 'text_zh_fallback', en: 'text_en_fallback'
    endcapture
    capture line_secondary
      render 'yarn-setting-text', settings: section.settings, key: 'secondary_label', zh: 'secondary_zh_fallback', en: 'secondary_en_fallback'
    endcapture
  endunless
  if section.settings.compact_layout
    capture line_heading
      render 'yarn-setting-text', settings: section.settings, key: 'compact_heading'
    endcapture
    capture line_secondary
      render 'yarn-setting-text', settings: section.settings, key: 'compact_action'
    endcapture
    capture line_text
      render 'yarn-setting-text', settings: section.settings, key: 'compact_text'
    endcapture
  endif
%}

<section id="line-support" class="yarn-line{% if section.settings.compact_layout %} yarn-line--compact{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="yarn-line__inner">
      {% unless section.settings.compact_layout %}<img class="yarn-line__flourish" src="{{ 'impeccable-next-section-flourish.png' | asset_url }}" alt="" width="1024" height="512" loading="lazy">{% endunless %}
      <div class="yarn-line__copy">
        <h2>{{ line_heading | escape }}</h2>
        {% if section.settings.compact_layout %}{% if line_text != blank %}<p class="yarn-line__note">{{ line_text | escape }}</p>{% endif %}{% else %}<div class="rte">{{ line_text }}</div>{% endif %}
      </div>
      <div class="yarn-line__actions">
        {% if line_has_primary %}
          <a class="button yarn-line__primary" href="{{ section.settings.primary_link }}">
            {{ line_primary | escape }}
          </a>
          <a class="yarn-line__secondary" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }} <span aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {% else %}
          <a class="button yarn-line__fallback" href="{{ section.settings.secondary_link | default: routes.contact_url }}">
            {{ line_secondary | escape }}{% if section.settings.compact_layout %}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>{% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-line.yarn-line {
    padding: clamp(64px, 7vw, 100px) 0;
    background: var(--yarn-bg-page);
    color: var(--yarn-text-primary);
  }

  .yarn-line__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 7vw, 108px);
    align-items: center;
    overflow: hidden;
    padding: clamp(42px, 6vw, 82px);
    border: 1px solid var(--yarn-cta-border);
    border-radius: 28px;
    background: var(--yarn-action-subtle-bg);
    box-shadow: none;
  }

  .yarn-line__flourish {
    position: absolute;
    right: -7%;
    bottom: -31%;
    width: min(48%, 590px);
    height: auto;
    opacity: 0.38;
    pointer-events: none;
  }

  .yarn-line__copy,
  .yarn-line__actions { position: relative; z-index: 1; }

  .yarn-line__copy h2 {
    margin: 0;
    max-width: 15em;
    color: var(--yarn-text-primary);
    font-size: clamp(3rem, 3.3vw, 4.8rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .yarn-line__copy .rte {
    max-width: 54rem;
    margin-top: 14px;
    color: var(--yarn-text-secondary);
    font-size: 1.5rem;
    line-height: 1.8;
  }

  .yarn-line__copy .rte p {
    margin: 0;
  }

  .yarn-line__actions {
    display: flex;
    min-width: 200px;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .yarn-line .yarn-line__primary {
    border-radius: var(--yarn-radius-pill);
    border-color: var(--yarn-accent);
    background: var(--yarn-accent);
    color: var(--yarn-text-on-action);
  }

  .yarn-line .yarn-line__fallback {
    border-radius: var(--yarn-radius-pill);
    border-color: var(--yarn-cta-bg);
    background: var(--yarn-cta-bg);
    color: var(--yarn-text-on-cta);
  }

  .yarn-line__secondary {
    color: var(--yarn-text-secondary);
    font-size: 1.3rem;
    text-align: center;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .yarn-line__secondary span,
  .yarn-line__secondary svg {
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: -2px;
  }

  @media screen and (max-width: 989px) {
    .yarn-line__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media screen and (max-width: 749px) {
    .yarn-line__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 34px 24px;
      border-radius: 20px;
    }

    .yarn-line__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
  .section:has(.yarn-line--compact) { margin-top: 0; }
  .yarn-line.yarn-line--compact { padding: var(--yarn-space-6) 0 72px; background: var(--yarn-bg-surface); color: var(--yarn-text-primary); }
  .yarn-line--compact > .page-width { width: min(var(--yarn-commerce-max), calc(100% - 2 * var(--yarn-gutter))); max-width: none; padding: 0; }
  .yarn-line--compact .yarn-line__inner { grid-template-columns: minmax(0, 1fr) auto; padding: 28px 32px; gap: 24px; min-height: 0; border: 1px solid var(--yarn-cta-border); border-radius: var(--yarn-radius-panel); background: var(--yarn-action-subtle-bg); box-shadow: none; }
  .yarn-line--compact .yarn-line__copy h2 { max-width: none; font: 600 2rem/1.4 var(--yarn-display); color: var(--yarn-text-primary); }
  .yarn-line__note { margin: 4px 0 0; color: var(--yarn-text-muted); font-size: 1.4rem; line-height: 1.6; }
  .yarn-line--compact .yarn-line__actions { min-width: 0; }
  .yarn-line--compact .yarn-line__fallback { min-height: 44px; padding: 0 24px; gap: 8px; border: 0; border-radius: var(--yarn-radius-pill); background: var(--yarn-home-action); color: var(--yarn-text-on-action); font: 600 1.5rem/1.2 var(--yarn-display); box-shadow: none; }
  .yarn-line--compact .yarn-line__fallback::before, .yarn-line--compact .yarn-line__fallback::after { display: none; }
  .yarn-line--compact .yarn-line__fallback:hover { background: var(--yarn-text-warm); }
  .yarn-line--compact .yarn-line__fallback svg { width: 16px; height: 16px; }
  @media (max-width: 749px) {
    .yarn-line.yarn-line--compact { padding: 24px 0 32px; }
    .yarn-line--compact > .page-width { width: calc(100% - 32px); }
    .yarn-line--compact .yarn-line__inner { grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 18px 16px; }
    .yarn-line--compact .yarn-line__copy h2 { font-size: 1.6rem; }
    .yarn-line__note { display: none; }
    .yarn-line--compact .yarn-line__actions { justify-self: start; }
    .yarn-line--compact .yarn-line__fallback { justify-content: flex-start; min-width: 0; min-height: 32px; padding: 0; gap: 8px; background: transparent; color: var(--yarn-action); font: 400 1.4rem/1.4 var(--yarn-body); }
    .yarn-line--compact .yarn-line__fallback:hover { background: transparent; text-decoration: underline; text-underline-offset: 5px; }
    .yarn-line--compact .yarn-line__fallback svg { width: 14px; height: 14px; }
  }
{% endstylesheet %}

