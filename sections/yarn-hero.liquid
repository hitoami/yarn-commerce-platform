{{ 'mewool-hero-project-node-v2.png' | asset_url | preload_tag: as: 'image' }}
{{ 'yarn-hero-b.css' | asset_url | stylesheet_tag }}

{% liquid
  capture hero_heading
    render 'yarn-setting-text', settings: section.settings, key: 'heading'
  endcapture
  capture hero_text
    render 'yarn-setting-text', settings: section.settings, key: 'text'
  endcapture
  capture hero_cta
    render 'yarn-setting-text', settings: section.settings, key: 'cta_label'
  endcapture
  capture flow_project
    render 'yarn-setting-text', settings: section.settings, key: 'flow_project'
  endcapture
  capture flow_yarn
    render 'yarn-setting-text', settings: section.settings, key: 'flow_yarn'
  endcapture
  capture flow_tools
    render 'yarn-setting-text', settings: section.settings, key: 'flow_tools'
  endcapture
%}

<section class="yarn-hero yarn-hero--connected color-{{ section.settings.color_scheme }}" aria-labelledby="YarnHeroHeading-{{ section.id }}">
  <div class="yarn-hero__visual">
    <div class="yarn-hero__copy">
      <h1 id="YarnHeroHeading-{{ section.id }}" class="yarn-hero__heading" lang="{{ request.locale.iso_code }}">{{ hero_heading | escape | newline_to_br }}</h1>
      {% if hero_text != blank %}<div class="yarn-hero__text rte">{{ hero_text }}</div>{% endif %}
      <a class="button yarn-hero__cta" href="{{ collections['yarn'].url | default: '#shop-by-project' }}">{{ hero_cta | escape }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
    </div>

    <ol class="yarn-hero__journey" aria-label="{{ flow_yarn | escape }} · {{ flow_project | escape }} · {{ flow_tools | escape }}">
      <svg class="yarn-hero__thread yarn-hero__thread--desktop" viewBox="0 0 1200 522" preserveAspectRatio="none" aria-hidden="true"><path d="M-160 440 C50 360 180 480 300 403 C350 372 329 324 308 350 C279 316 270 374 319 396 C388 432 452 408 515 342 C645 252 792 174 843 116 C861 95 840 80 831 100 C820 129 864 149 902 95 C977 26 1173 46 1176 162 C1176 201 1137 198 1146 178 C1161 153 1199 206 1170 243 C1134 299 1050 372 1005 439 C937 512 827 490 796 448"/></svg>
      <svg class="yarn-hero__thread yarn-hero__thread--mobile" viewBox="0 0 358 360" preserveAspectRatio="none" aria-hidden="true"><path d="M-25 300 C20 275 40 330 83 297 C113 275 95 250 83 267 C65 248 63 280 86 291 C117 313 144 275 174 246 C219 211 247 143 264 97 C273 70 252 66 250 81 C248 102 279 113 303 84 C337 75 365 114 347 149 C329 175 324 149 337 150 C367 155 346 213 319 246 C290 283 267 338 229 346 C196 357 174 339 170 321"/></svg>
      <li class="yarn-hero__node yarn-hero__node--project">
        <a href="{{ collections['knit-kits'].url | default: '#shop-by-project' }}">
          <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-project-node-v2.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager" fetchpriority="high"></span>
          <strong lang="{{ request.locale.iso_code }}">{{ flow_project | escape }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></strong>
        </a>
      </li>
      <li class="yarn-hero__node yarn-hero__node--yarn">
        <a href="{{ collections['yarn'].url | default: '#shop-by-project' }}">
          <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-yarn-node.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager"></span>
          <strong lang="{{ request.locale.iso_code }}">{{ flow_yarn | escape }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></strong>
        </a>
      </li>
      <li class="yarn-hero__node yarn-hero__node--tools">
        <a href="{{ collections['finished-goods'].url | default: '#shop-by-project' }}">
          <span class="yarn-hero__node-art"><img src="{{ 'mewool-hero-finished-node.png' | asset_url }}" alt="" width="1254" height="1254" loading="eager"></span>
          <strong lang="{{ request.locale.iso_code }}">{{ flow_tools | escape }} <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></strong>
        </a>
      </li>
    </ol>
  </div>
  <svg class="yarn-hero__wave" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><path opacity=".65" d="M0 0C330 0 480 145 900 111S1240 45 1440 54V130H0Z"/><path style="fill: var(--yarn-bg-surface)" d="M0 54C350 13 509 161 939 122S1255 83 1440 88V130H0Z"/></svg>
</section>

{% schema %}
{
  "name": "首页 · 毛线串联主视觉",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" },
    { "type": "textarea", "id": "heading", "label": "日文 · 主标题", "default": "好きな作品から、\n手づくりを始めよう。" },
    { "type": "richtext", "id": "text", "label": "日文 · 说明", "default": "<p>作品に合わせて、毛糸・使用量・道具・作り方をひとつずつ準備できます。</p>" },
    { "type": "text", "id": "cta_label", "label": "日文 · 主操作", "default": "作品を見つける" },
    { "type": "text", "id": "flow_project", "label": "日文 · 步骤一", "default": "作品を選ぶ" },
    { "type": "text", "id": "flow_yarn", "label": "日文 · 步骤二", "default": "毛糸を選ぶ" },
    { "type": "text", "id": "flow_tools", "label": "日文 · 步骤三", "default": "道具をそろえる" },
    { "type": "text", "id": "flow_tutorial", "label": "日文 · 步骤四", "default": "作り方を見る" },
    { "type": "textarea", "id": "heading_zh", "label": "中文 · 主标题", "default": "从喜欢的作品，\n开始你的手作。" },
    { "type": "richtext", "id": "text_zh", "label": "中文 · 说明", "default": "<p>毛线、用量、工具与教程，跟着作品慢慢准备。</p>" },
    { "type": "text", "id": "cta_label_zh", "label": "中文 · 主操作", "default": "发现作品" },
    { "type": "text", "id": "flow_project_zh", "label": "中文 · 步骤一", "default": "选作品" },
    { "type": "text", "id": "flow_yarn_zh", "label": "中文 · 步骤二", "default": "挑毛线" },
    { "type": "text", "id": "flow_tools_zh", "label": "中文 · 步骤三", "default": "找工具" },
    { "type": "text", "id": "flow_tutorial_zh", "label": "中文 · 步骤四", "default": "看教程" },
    { "type": "textarea", "id": "heading_en", "label": "英文 · 主标题", "default": "Start making from\na project you love." },
    { "type": "richtext", "id": "text_en", "label": "英文 · 说明", "default": "<p>Follow the project to prepare your yarn, quantity, tools, and tutorial one step at a time.</p>" },
    { "type": "text", "id": "cta_label_en", "label": "英文 · 主操作", "default": "Discover projects" },
    { "type": "text", "id": "flow_project_en", "label": "英文 · 步骤一", "default": "Choose a project" },
    { "type": "text", "id": "flow_yarn_en", "label": "英文 · 步骤二", "default": "Pick yarn" },
    { "type": "text", "id": "flow_tools_en", "label": "英文 · 步骤三", "default": "Find tools" },
    { "type": "text", "id": "flow_tutorial_en", "label": "英文 · 步骤四", "default": "View tutorial" }
  ],
  "presets": [{ "name": "首页 · 毛线串联主视觉" }]
}
{% endschema %}
