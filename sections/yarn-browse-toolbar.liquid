{{ 'yarn-cards.css' | asset_url | stylesheet_tag }}
{{ 'yarn-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-browse-toolbar.js' | asset_url }}" defer="defer"></script>
{% comment %}
  统一浏览工具栏(Issue #55):品类 tab + 价格带 chips。
  tab/chip 均为 blocks,运营可在主题编辑器调整;价格带用 Shopify 原生
  filter.v.price 参数(已实测生效)。当前 tab 高亮按集合 handle;chip 高亮由
  yarn-browse-toolbar.js 按查询参数标记,并合并现有参数(无 JS 时链接直达)。
  标签按 yarn-hero 三联模式:纯键名为日文默认,_zh/_en 为中英覆盖;留空则用集合名。
  分类标签(Issue #117):设置里列出的 Search & Discovery 筛选(默认 yarn.texture / yarn.use)
  不进下拉,而是平铺成一排常驻标签,与首页圆图同名同链接;单选,「全部」清除这些筛选。
{% endcomment %}
{%- liquid
  assign cat_params = section.settings.category_filters | remove: ' ' | split: ','
  assign cat_order = section.settings.category_order | remove: ' ' | split: ','
  assign cat_active = false
  for filter in collection.filters
    if cat_params contains filter.param_name
      for value in filter.values
        if value.active
          assign cat_active = true
        endif
      endfor
    endif
  endfor
-%}
{%- capture cat_chips -%}
  {%- for param in cat_params -%}
    {%- for filter in collection.filters -%}
      {%- if filter.param_name == param -%}
        {%- comment -%} 标签按设置里的「毛线入口」handle 顺序排列,与首页圆图一致;Search & Discovery 的自动排序会因语言不同而变。{%- endcomment -%}
        {%- for entry_handle in cat_order -%}
          {%- assign entry = metaobjects.yarn_entry[entry_handle] -%}
          {%- if entry == blank -%}{%- continue -%}{%- endif -%}
          {%- assign entry_gid = 'gid://shopify/Metaobject/' | append: entry.system.id -%}
          {%- for value in filter.values -%}
            {%- comment -%} 选中某个分类后,其他分类的数量会按当前筛选重算,所以只在未选分类时显示款数,且标签一直保留。{%- endcomment -%}
            {%- if value.value == entry_gid and value.count > 0 or value.value == entry_gid and cat_active -%}
              <a class="yx-chip yx-cat{% if value.active %} yx-chip--active{% endif %}"{% if value.active %} aria-current="true"{% endif %} href="{{ collection.url }}?{{ value.param_name }}={{ value.value | url_encode }}">{{ value.label | escape }}{% unless cat_active %}<span class="yx-cat__count">{{ value.count }}</span>{% endunless %}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="yx-toolbar page-width" data-yx-toolbar>
  <form class="yx-toolbar__search" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="BrowseSearch-{{ section.id }}">{{ 'yarn_project.browse_search' | t }}</label>
    <input id="BrowseSearch-{{ section.id }}" type="search" name="q" placeholder="{{ 'yarn_project.browse_search' | t }}" autocomplete="off">
    <input type="hidden" name="type" value="product">
    <button type="submit" aria-label="{{ 'general.search.search' | t }}">{{ 'icon-search.svg' | inline_asset_content }}</button>
  </form>
  <nav class="yx-toolbar__tabs" aria-label="{{ 'yarn_project.browse_categories' | t }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        {%- assign tab_collection = collections[block.settings.collection] -%}
        {%- if tab_collection != blank -%}
          {%- liquid
            capture tab_label
              render 'yarn-setting-text', settings: block.settings, key: 'label'
            endcapture
          -%}
          <a class="yx-chip{% if collection.handle == tab_collection.handle %} yx-chip--active{% endif %}" {% if collection.handle == tab_collection.handle %}aria-current="page"{% endif %} href="{{ tab_collection.url }}" {{ block.shopify_attributes }}>{{ tab_label | default: tab_collection.title | escape }}</a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </nav>
  {%- if cat_chips != blank -%}
    <nav class="yx-toolbar__cats" aria-label="{{ 'yarn_project.browse_yarn_types' | t }}">
      <a class="yx-chip yx-cat{% unless cat_active %} yx-chip--active{% endunless %}"{% unless cat_active %} aria-current="true"{% endunless %} href="{{ collection.url }}">{{ 'yarn_project.browse_category_all' | t }}</a>
      {{ cat_chips }}
    </nav>
  {%- endif -%}
  <div class="yx-toolbar__chips">
    <a class="yx-chip" data-yx-chip data-yx-param="" href="{{ collection.url }}">{{ 'yarn_project.browse_price_any' | t }}</a>
    {%- for block in section.blocks -%}
      {%- if block.type == 'chip' -%}
        {%- liquid
          capture chip_label
            render 'yarn-setting-text', settings: block.settings, key: 'label'
          endcapture
        -%}
        <a class="yx-chip" data-yx-chip data-yx-param="{{ block.settings.param | escape }}" href="{{ collection.url }}?{{ block.settings.param | escape }}" {{ block.shopify_attributes }}>{{ chip_label | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <form class="yx-toolbar__filters" action="{{ collection.url }}" method="get" data-yx-filters>
    {% for filter in collection.filters %}
      {% if cat_params contains filter.param_name and cat_chips != blank %}
        {% continue %}
      {% elsif filter.type == 'price_range' %}
        {% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{% endif %}
        {% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endif %}
      {% else %}
        <details class="yx-toolbar__facet">
          <summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}<span aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
          <div class="yx-toolbar__facet-panel">
            <fieldset><legend class="visually-hidden">{{ filter.label | escape }}</legend>
              {% for value in filter.values %}
                <label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% elsif value.count == 0 %}disabled{% endif %}>{{ value.label | escape }} <span>({{ value.count }})</span></label>
              {% endfor %}
            </fieldset>
            <button class="yx-toolbar__submit" type="submit">{{ 'products.facets.apply' | t }}</button>
          </div>
        </details>
      {% endif %}
    {% endfor %}
    <div class="yx-toolbar__filter">
      <label for="BrowseSort-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
      <select id="BrowseSort-{{ section.id }}" name="sort_by" data-yx-sort>
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
      </select>
    </div>
    <noscript><button class="yx-toolbar__submit" type="submit">{{ 'products.facets.apply' | t }}</button></noscript>
  </form>
  <p class="yx-toolbar__count" role="status">{{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}</p>
</div>
{% schema %}
{
  "name": "浏览工具栏(品类+价格带)",
  "settings": [
    { "type": "text", "id": "category_filters", "label": "平铺为分类标签的筛选参数", "default": "filter.p.m.yarn.texture,filter.p.m.yarn.use", "info": "逗号分隔;需与首页圆图入口使用同一组商品字段" },
    { "type": "text", "id": "category_order", "label": "分类标签顺序(毛线入口 handle)", "default": "gradient,fluffy,loop-fancy,fine-airy,basic-solid,amigurumi,bags-home,spring-summer-cotton", "info": "逗号分隔;与首页圆图顺序一致。未列出的入口不显示为标签" }
  ],
  "blocks": [
    { "type": "tab", "name": "品类 Tab", "settings": [
      { "type": "collection", "id": "collection", "label": "集合" },
      { "type": "text", "id": "label", "label": "日文 · 标签(空则用集合名)" },
      { "type": "text", "id": "label_zh", "label": "中文 · 标签" },
      { "type": "text", "id": "label_en", "label": "英文 · 标签" }
    ] },
    { "type": "chip", "name": "价格带", "settings": [
      { "type": "text", "id": "label", "label": "日文 · 标签", "default": "¥500未満" },
      { "type": "text", "id": "label_zh", "label": "中文 · 标签" },
      { "type": "text", "id": "label_en", "label": "英文 · 标签" },
      { "type": "text", "id": "param", "label": "筛选参数", "default": "filter.v.price.lte=499", "info": "如 filter.v.price.gte=500&filter.v.price.lte=1499" }
    ] }
  ],
  "presets": [ { "name": "浏览工具栏(品类+价格带)" } ]
}
{% endschema %}
