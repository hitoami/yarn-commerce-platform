{%- comment -%}
  购物车整页（Issue #124，Claude Design「购物车」Cart.dc.html：手机 1a / 1d，桌面 2a / 2b）。
  条目、小计与结账都在本 section：cart.js 按 #main-cart-items / #main-cart-footer / #YarnCartCount 局部刷新。
  空购物车的入口按钮、新手卡与帮助条是运营文案，链接为空时不渲染。
{%- endcomment -%}
{{ 'yarn-cart.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- liquid
  capture empty_text
    render 'yarn-setting-text', settings: section.settings, key: 'empty_text'
  endcapture
  capture projects_label
    render 'yarn-setting-text', settings: section.settings, key: 'projects_label'
  endcapture
  capture yarn_label
    render 'yarn-setting-text', settings: section.settings, key: 'yarn_label'
  endcapture
  capture beginner_heading
    render 'yarn-setting-text', settings: section.settings, key: 'beginner_heading'
  endcapture
  capture beginner_text
    render 'yarn-setting-text', settings: section.settings, key: 'beginner_text'
  endcapture
  capture help_heading
    render 'yarn-setting-text', settings: section.settings, key: 'help_heading'
  endcapture
  capture help_label
    render 'yarn-setting-text', settings: section.settings, key: 'help_label'
  endcapture

  assign show_projects = false
  if section.settings.projects_link != blank and projects_label != blank
    assign show_projects = true
  endif
  assign show_yarn = false
  if section.settings.yarn_link != blank and yarn_label != blank
    assign show_yarn = true
  endif
  assign show_beginner = false
  if section.settings.beginner_link != blank and beginner_heading != blank
    assign show_beginner = true
  endif
-%}

{%- capture help_strip -%}
  {%- if section.settings.help_link != blank and help_heading != blank -%}
    <a class="yarn-cart-help" href="{{ section.settings.help_link }}">
      <span class="yarn-cart-help__title">{{ help_heading | escape }}</span>
      {%- if help_label != blank -%}
        <span class="yarn-cart-help__action">{{ help_label | escape }}<span aria-hidden="true">→</span></span>
      {%- endif -%}
    </a>
  {%- endif -%}
{%- endcapture -%}

<cart-items
  class="yarn-cart color-{{ section.settings.color_scheme }} gradient{% if cart == empty %} is-empty{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="yarn-cart__filled">
    <div class="yarn-cart__head">
      <h1 class="yarn-cart__title">{{ 'yarn_cart.title' | t }}</h1>
      <span class="yarn-cart__count" id="YarnCartCount">{{ 'yarn_cart.item_count' | t: count: cart.item_count }}</span>
    </div>

    <div class="yarn-cart__layout">
      <div class="yarn-cart__main">
        <form action="{{ routes.cart_url }}" class="yarn-cart__form" method="post" id="cart">
          <div class="yarn-cart__items" id="main-cart-items" data-id="{{ section.id }}">
            <div class="js-contents">
              {%- if cart != empty -%}
                <div class="yarn-cart__labels" aria-hidden="true">
                  <span>{{ 'yarn_cart.heading_product' | t }}</span>
                  <span>{{ 'yarn_cart.heading_quantity' | t }}</span>
                  <span>{{ 'yarn_cart.heading_total' | t }}</span>
                </div>
                <ul class="yarn-cart__list" role="list" aria-label="{{ 'yarn_cart.title' | t }}">
                  {%- for item in cart.items -%}
                    {%- liquid
                      capture localized_cart_title
                        render 'yarn-product-title', product: item.product
                      endcapture
                      assign localized_cart_title = localized_cart_title | strip
                      capture kind_label
                        render 'yarn-product-kind-label', kind_product: item.product
                      endcapture
                      assign kind_label = kind_label | strip
                      assign kind_class = ''
                      if item.product.tags contains '編みものキット'
                        assign kind_class = ' yarn-cart-item__badge--kit'
                      elsif item.product.tags contains '完成品'
                        assign kind_class = ' yarn-cart-item__badge--finished'
                      endif
                      assign line = item.index | plus: 1

                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif
                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                      assign can_update_quantity = item.instructions.can_update_quantity | default: true
                      assign can_remove = item.instructions.can_remove | default: true
                    -%}
                    <li
                      class="cart-item yarn-cart-item{% if item.parent_relationship.parent != null %} yarn-cart-item--nested{% endif %}"
                      id="CartItem-{{ line }}"
                      {% if item.parent_relationship.parent != null %}
                        aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                      {% endif %}
                    >
                      <a class="yarn-cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                        {%- if item.image -%}
                          <img
                            src="{{ item.image | image_url: width: 240 }}"
                            srcset="{{ item.image | image_url: width: 120 }} 120w, {{ item.image | image_url: width: 240 }} 240w"
                            sizes="(min-width: 990px) 112px, 88px"
                            alt=""
                            loading="lazy"
                            width="240"
                            height="{{ 240 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        {%- endif -%}
                      </a>

                      {%- if kind_label != blank -%}
                        <span class="yarn-cart-item__badge{{ kind_class }}">{{ kind_label }}</span>
                      {%- endif -%}

                      <div class="yarn-cart-item__title">
                        <a href="{{ item.url }}" class="yarn-cart-item__name">{{ localized_cart_title | escape }}</a>
                        {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-cart-' | append: item.key | replace: ':', '-' -%}
                        {%- render 'cart-disclosure-indicator', product: item.product, modal_id: cart_disclosure_modal_id -%}
                      </div>

                      <div class="yarn-cart-item__meta">
                        {%- if item.product.has_only_default_variant == false -%}
                          <p class="yarn-cart-item__options">
                            {%- for option in item.options_with_values -%}
                              {%- capture option_name -%}{%- render 'yarn-option-label', option_name: option.name -%}{%- endcapture -%}
                              {{- 'yarn_pdp.option_selected' | t: name: option_name, value: option.value -}}
                              {%- unless forloop.last %} · {% endunless -%}
                            {%- endfor -%}
                          </p>
                        {%- endif -%}

                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            {%- capture property_name -%}
                              {%- case property.first -%}
                                {%- when 'Project' -%}{{ 'yarn_project.project_label' | t }}
                                {%- when 'Component' -%}{{ 'yarn_project.item_label' | t }}
                                {%- else -%}{{ property.first | escape }}
                              {%- endcase -%}
                            {%- endcapture -%}
                            <p>
                              {%- if property.last contains '/uploads/' -%}
                                {%- assign upload_name = property.last | split: '/' | last -%}
                                <a href="{{ property.last }}" target="_blank">{{ 'yarn_pdp.option_selected' | t: name: property_name, value: upload_name }}</a>
                              {%- else -%}
                                {{ 'yarn_pdp.option_selected' | t: name: property_name, value: property.last }}
                              {%- endif -%}
                            </p>
                          {%- endif -%}
                        {%- endfor -%}

                        {%- if item.selling_plan_allocation != null -%}
                          <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}

                        {%- render 'yarn-cart-project', item: item -%}

                        {%- if item.line_level_discount_allocations.size > 0 -%}
                          <ul class="yarn-cart__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li>
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title | escape }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>

                      <cart-remove-button
                        class="yarn-cart-item__remove{% if can_remove == false %} hidden{% endif %}"
                        id="Remove-{{ line }}"
                        data-index="{{ line }}"
                      >
                        <a
                          href="{{ item.url_to_remove }}"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: localized_cart_title | escape }}"
                        >
                          <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                          <span class="yarn-cart-item__remove-label">{{ 'yarn_cart.remove' | t }}</span>
                        </a>
                      </cart-remove-button>

                      <div class="yarn-cart-item__quantity">
                        <quantity-popover>
                          <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                            <label class="visually-hidden" for="Quantity-{{ line }}">
                              {{ 'products.product.quantity.label' | t }}
                            </label>
                            <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                              {%- if has_qty_rules or has_vol_pricing -%}
                                <button
                                  type="button"
                                  aria-expanded="false"
                                  class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                                >
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </button>
                              {%- endif -%}
                              <quantity-input class="quantity cart-quantity">
                                <button class="quantity__button" name="minus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                                  <span class="visually-hidden">
                                    {{- 'products.product.quantity.decrease' | t: product: localized_cart_title | escape -}}
                                  </span>
                                  <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                                </button>
                                <input
                                  class="quantity__input"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  data-quantity-line-key="{{ item.key }}"
                                  type="number"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  {% # theme-check-disable %}
                                  data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                  min="0"
                                  data-min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  {% # theme-check-enable %}
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: localized_cart_title | escape }}"
                                  id="Quantity-{{ line }}"
                                  data-index="{{ line }}"
                                  {% if can_update_quantity == false %}
                                    disabled
                                  {% endif %}
                                >
                                <button class="quantity__button" name="plus" type="button" {% if can_update_quantity == false %}disabled{% endif %}>
                                  <span class="visually-hidden">
                                    {{- 'products.product.quantity.increase' | t: product: localized_cart_title | escape -}}
                                  </span>
                                  <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                                </button>
                              </quantity-input>
                            </div>
                          </div>
                          {%- if has_qty_rules or has_vol_pricing -%}
                            <button
                              type="button"
                              class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                              aria-expanded="false"
                            >
                              {{- 'icon-info.svg' | inline_asset_content -}}
                              <span>
                                {%- if has_vol_pricing -%}
                                  {{ 'products.product.volume_pricing.note' | t }}
                                {%- elsif has_qty_rules -%}
                                  {{ 'products.product.quantity.note' | t }}
                                {%- endif -%}
                              </span>
                            </button>
                            <div class="cart-items__info global-settings-popup quantity-popover__info" tabindex="-1" hidden>
                              {%- if has_qty_rules == false -%}
                                <span class="volume-pricing-label caption">{{- 'products.product.volume_pricing.title' | t -}}</span>
                              {%- endif -%}
                              <div class="quantity__rules caption">
                                {%- if item.variant.quantity_rule.increment > 1 -%}
                                  <span class="divider">{{- 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment -}}</span>
                                {%- endif -%}
                                {%- if item.variant.quantity_rule.min > 1 -%}
                                  <span class="divider">{{- 'products.product.quantity.min_of' | t: quantity: item.variant.quantity_rule.min -}}</span>
                                {%- endif -%}
                                {%- if item.variant.quantity_rule.max != null -%}
                                  <span class="divider">{{- 'products.product.quantity.max_of' | t: quantity: item.variant.quantity_rule.max -}}</span>
                                {%- endif -%}
                              </div>
                              <button class="button-close button button--tertiary large-up-hide" type="button" aria-label="{{ 'accessibility.close' | t }}">
                                <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
                              </button>
                              {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                <volume-pricing class="parent-display">
                                  <ul class="list-unstyled">
                                    <li>
                                      <span>{{ item.variant.quantity_rule.min }}+</span>
                                      {%- assign price = item.variant.price | money -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                    {%- for price_break in item.variant.quantity_price_breaks -%}
                                      <li>
                                        <span>{{- price_break.minimum_quantity -}}<span aria-hidden="true">+</span></span>
                                        {%- assign price = price_break.price | money -%}
                                        <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </volume-pricing>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          <div class="cart-item__error" id="Line-item-error-{{ line }}" role="alert">
                            <small class="cart-item__error-text"></small>
                            <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                          </div>
                        </quantity-popover>
                      </div>

                      <div class="yarn-cart-item__total">
                        {%- render 'loading-spinner' -%}
                        <div class="yarn-cart-item__price">
                          {%- if item.original_line_price != item.final_line_price -%}
                            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                            <s class="yarn-cart-item__compare">{{ item.original_line_price | money }}</s>
                            <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                          {%- endif -%}
                          <span class="yarn-cart-item__amount">{{ item.final_line_price | money }}</span>
                          {%- if item.variant.available and item.unit_price_measurement -%}
                            {%- render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>

          <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
          <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
            {{ 'accessibility.loading' | t }}
          </p>
        </form>

        <a class="yarn-cart__continue-link" href="{{ routes.all_products_collection_url }}">
          {{- 'general.continue_shopping' | t -}}<span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="yarn-cart__aside">
        <div class="yarn-cart__summary" id="main-cart-footer" data-id="{{ section.id }}">
          <h2 class="visually-hidden">{{ 'yarn_cart.summary_heading' | t }}</h2>
          <div class="js-contents">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="yarn-cart__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    {{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="yarn-cart__subtotal">
              <span>{{ 'yarn_cart.subtotal' | t: count: cart.item_count }}</span>
              <span class="yarn-cart__subtotal-price">{{ cart.total_price | money }}</span>
            </div>
            <p class="yarn-cart__tax">
              {%- if cart.duties_included and cart.taxes_included -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- elsif cart.duties_included == false and cart.taxes_included -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- elsif cart.duties_included and cart.taxes_included == false -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- else -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- endif -%}
            </p>
          </div>

          {%- if settings.show_cart_note -%}
            <cart-note class="yarn-cart__note">
              <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
              <textarea name="note" form="cart" id="Cart-note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
            </cart-note>
          {%- endif -%}

          <button
            type="submit"
            id="checkout"
            class="yarn-cart__checkout"
            name="checkout"
            form="cart"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ 'yarn_cart.checkout' | t }}
          </button>

          {%- if additional_checkout_buttons -%}
            <div class="yarn-cart__dynamic additional-checkout-buttons">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}

          <div id="cart-errors" class="yarn-cart__errors"></div>

          <a class="yarn-cart__continue-button" href="{{ routes.all_products_collection_url }}">
            {{- 'general.continue_shopping' | t -}}
          </a>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}

        {{ help_strip }}
      </div>
    </div>
  </div>

  <div class="yarn-cart__empty">
    <div class="yarn-cart__band">
      <span class="yarn-cart__cat" aria-hidden="true"></span>
      <h1 class="yarn-cart__empty-title">{{ 'yarn_cart.empty_title' | t }}</h1>
      {%- if empty_text != blank -%}
        <p class="yarn-cart__empty-text">{{ empty_text | escape }}</p>
      {%- endif -%}
      {%- if show_projects or show_yarn -%}
        <div class="yarn-cart__empty-actions">
          {%- if show_projects -%}
            <a class="yarn-cart__button yarn-cart__button--primary" href="{{ section.settings.projects_link }}">{{ projects_label | escape }}</a>
          {%- endif -%}
          {%- if show_yarn -%}
            <a class="yarn-cart__button {% if show_projects %}yarn-cart__button--secondary{% else %}yarn-cart__button--primary{% endif %}" href="{{ section.settings.yarn_link }}">{{ yarn_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if show_beginner or help_strip != blank -%}
      <div class="yarn-cart__empty-more">
        {%- if show_beginner -%}
          <a class="yarn-cart-beginner" href="{{ section.settings.beginner_link }}">
            <span class="yarn-cart-beginner__icon" aria-hidden="true">{{- 'icon-sprout.svg' | inline_asset_content -}}</span>
            <span class="yarn-cart-beginner__copy">
              <span class="yarn-cart-beginner__title">{{ beginner_heading | escape }}</span>
              {%- if beginner_text != blank -%}
                <span class="yarn-cart-beginner__text">{{ beginner_text | escape }}</span>
              {%- endif -%}
            </span>
            <span class="yarn-cart-beginner__arrow" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {%- endif -%}
        {{ help_strip }}
      </div>
    {%- endif -%}
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "空购物车" },
    { "type": "textarea", "id": "empty_text", "label": "说明 · 日文", "default": "何を編むか決まっていなくても大丈夫。まずは毛糸をのぞいてみてください。" },
    { "type": "textarea", "id": "empty_text_zh", "label": "说明 · 中文", "default": "还没决定织什么？可以先看看毛线。" },
    { "type": "textarea", "id": "empty_text_en", "label": "说明 · 英文", "default": "Not sure what to make yet? Start by browsing our yarn." },
    { "type": "url", "id": "projects_link", "label": "主按钮链接（作品库）", "info": "留空则不显示主按钮" },
    { "type": "text", "id": "projects_label", "label": "主按钮 · 日文", "default": "作品から選ぶ" },
    { "type": "text", "id": "projects_label_zh", "label": "主按钮 · 中文", "default": "按作品图选" },
    { "type": "text", "id": "projects_label_en", "label": "主按钮 · 英文", "default": "Shop by project" },
    { "type": "url", "id": "yarn_link", "label": "毛线按钮链接", "info": "留空则不显示" },
