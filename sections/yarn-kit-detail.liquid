{% comment %}
  材料包详情(#131,yarn_project 网页):内容页,买的始终是毛线商品本身,购物车里没有「材料包」这种商品。
  所需毛线 = 配件(yarn_material)里类型为「毛线」且关联了 Variant 的条目;团数取配件的 quantity(空为 1)。
  只有 1 行毛线时显示购买框(团数预填、可改,一键加入购物车),看起来像商品页;2 行及以上显示清单(逐个加购)+ 合计 + 全部加入购物车。
  其他配件(非毛线或未关联商品)列在「需要自备」,不进购物车。教程不在网站上:tutorial_url 填官方 LINE 链接,按钮说明购买后在 LINE 获取。
  加购带隐藏属性 _Kit / _Kit handle,方便以后在购物车或订单里认出来源。
  #177 R2(用户 2026-10-17 确认手机稿 A1):每种线一行、行内团数步进器(默认原作团数);一个主按钮——
  全部可买为「全部加入购物车」,部分缺货为「只加入可买的 N 团」(缺的不自动换线或换色),一行都买不了时不放禁用按钮,
  改为说明 + 询问到货(主题设置「官方 LINE 链接」,留空为联系页)+ 看其他材料包。教程改为三步说明 + 文字链接。
  #182 v2(Figma 03 页,借鉴 Woobles):封面波浪底边;标题下 ✓ 清单 + 快捷主按钮;「你会收到什么」两栏(包裹里 / 需要自备,
  自备无配件时只写「工具以教程为准」);教程三步带插画图标;手机吸底栏(封面 + 合计 + 全部加入)。快捷按钮与吸底栏只转发点击到
  购买区的主按钮(yarn-kit-proxy),加购逻辑与状态仍只在 yarn-kit-buy 里。
{% endcomment %}
{{ 'yarn-cards.css' | asset_url | stylesheet_tag }}
{{ 'yarn-kit.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-kit.js' | asset_url }}" defer="defer"></script>
{%- assign project = metaobject -%}
{%- capture visible -%}{%- render 'yarn-kit-visible', project: project -%}{%- endcapture -%}
{%- liquid
  assign yarn_rows = 0
  assign self_rows = 0
  assign ready_rows = 0
  assign ready_balls = 0
  assign ready_total = 0
  assign missing_name = blank
  assign missing_pending = false
  assign kit_balls_list = ''
  assign colour_pending_any = false
  for component in project.components.value
    if component.component_type.value == '毛线' and component.variant.value != blank
      assign yarn_rows = yarn_rows | plus: 1
      assign row_qty = component.quantity.value | default: 1
      capture kit_ball_item
        echo 'yarn_project.kit_yarn_line' | t: name: component.variant.value.product.title, count: row_qty
      endcapture
      if kit_balls_list != ''
        assign kit_balls_list = kit_balls_list | append: '、'
      endif
      assign kit_balls_list = kit_balls_list | append: kit_ball_item
      if component.variant.value.product.has_only_default_variant
        assign colour_pending_any = true
      endif
      assign row_ok = true
      unless component.variant.value.available
        assign row_ok = false
      endunless
      if component.variant.value.price <= 0
        assign row_ok = false
      endif
      if row_ok
        assign ready_rows = ready_rows | plus: 1
        assign ready_balls = ready_balls | plus: row_qty
        assign row_ready_total = component.variant.value.price | times: row_qty
        assign ready_total = ready_total | plus: row_ready_total
      elsif missing_name == blank
        assign missing_name = component.variant.value.product.title
        if component.variant.value.price <= 0
          assign missing_pending = true
        endif
      endif
    else
      assign self_rows = self_rows | plus: 1
    endif
  endfor
-%}
<article class="yk-detail">
  {%- if visible == 'true' -%}
  {%- assign list_url = section.settings.list_url | default: '/pages/kits' -%}
  <nav class="yk-crumb" aria-label="breadcrumb">
    <a href="{% render 'yarn-local-url', url: list_url %}">{{ 'yarn_project.kit_all' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ project.title.value | escape }}</span>
  </nav>
  <div class="yk-layout">
    <div class="yk-cover">
      {%- if project.cover.value != blank -%}
        {{ project.cover.value | image_url: width: 1600 | image_tag: widths: '390, 600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: project.title.value }}
      {%- else -%}
        <div class="yk-placeholder" aria-hidden="true"></div>
      {%- endif -%}
      <span class="yk-cover__badge">{{ 'yarn_project.kit_badge' | t }} · {{ 'yarn_project.kit_check_no_tools_short' | t }}</span>
      <svg class="yk-cover__wave" viewBox="0 0 390 28" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 28 C 65 0 130 0 195 14 S 325 28 390 4 L390 28 Z" fill="currentColor"/></svg>
    </div>
    <div class="yk-main">
      <header class="yk-head">
        {%- if project.release_scope.value == '仅内部原型' -%}<p class="yk-demo">{{ 'yarn_project.demo_content' | t }}</p>{%- endif -%}
        <span class="yk-pill">{{ 'yarn_project.kit_no_tools' | t }}</span>
        <h1 class="yk-title">{{ project.title.value | escape }}</h1>
        {%- if project.summary.value != blank -%}<p class="yk-summary">{{ project.summary.value | escape | newline_to_br }}</p>{%- endif -%}
        {%- if project.difficulty.value != blank or project.made_for.value != blank or project.holiday.value != blank -%}
          <ul class="yk-facts" role="list">
            {%- if project.difficulty.value != blank -%}<li>{% render 'yarn-project-label', value: project.difficulty.value %}</li>{%- endif -%}
            {%- if project.made_for.value != blank -%}<li data-proof-content>{{ project.made_for.value | escape }}</li>{%- endif -%}
            {%- if project.holiday.value != blank -%}<li data-proof-content>{{ project.holiday.value | escape }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- if yarn_rows > 0 -%}
          <ul class="yk-check" role="list">
            <li class="yk-check__row"><span class="svg-wrapper" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span><span data-proof-content>{{ 'yarn_project.kit_check_balls' | t: list: kit_balls_list | escape }}</span></li>
            {%- if project.tutorial_url.value != blank -%}<li class="yk-check__row"><span class="svg-wrapper" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span><span>{{ 'yarn_project.kit_check_tutorial' | t }}</span></li>{%- endif -%}
            <li class="yk-check__row yk-check__row--info"><span class="svg-wrapper" aria-hidden="true">{{ 'icon-info.svg' | inline_asset_content }}</span><span>{{ 'yarn_project.kit_check_no_tools' | t }}{% if colour_pending_any %} · {{ 'yarn_pdp.colour_pending' | t }}{% endif %}</span></li>
          </ul>
          {%- if ready_rows > 0 -%}
            <yarn-kit-proxy class="yk-quick">
              <button type="button" class="yk-add-all yk-quick__button" data-kit-proxy>{% if ready_rows == yarn_rows %}{% if yarn_rows == 1 %}{{ 'yarn_project.kit_add' | t }}{% else %}{{ 'yarn_project.kit_add_all' | t }}{% endif %}{% else %}{{ 'yarn_project.kit_add_available' | t: count: ready_balls }}{% endif %} · {{ ready_total | money }}</button>
              <p class="yk-quick__hint">{{ 'yarn_project.kit_quick_hint' | t }}</p>
            </yarn-kit-proxy>
          {%- endif -%}
        {%- endif -%}
      </header>

      {%- if yarn_rows > 0 -%}
      {%- liquid
        assign kit_line = settings.yarn_line_url
        if kit_line == blank
          capture kit_line
            render 'yarn-local-url', url: '/pages/contact'
          endcapture
        endif
        assign tax_note = ''
        if cart.taxes_included
          assign tax_note = 'yarn_project.kit_total_tax' | t
        endif
      -%}
      <yarn-kit-buy class="yk-buy{% if yarn_rows == 1 %} yk-buy--single{% endif %}"
        data-all-label="{% if yarn_rows == 1 %}{{ 'yarn_project.kit_add' | t | escape }}{% else %}{{ 'yarn_project.kit_add_all' | t | escape }}{% endif %}" data-available-label="{{ 'yarn_project.kit_add_available' | t: count: '[count]' | escape }}" data-currency="{{ cart.currency.iso_code }}" data-money-format="{{ shop.money_format | strip_html | escape }}" data-locale="{{ request.locale.iso_code }}" data-total-label="{{ 'yarn_project.kit_total' | t: count: '[count]' | escape }}{{ tax_note | escape }}" data-not-on-sale="{{ 'yarn_project.kit_not_on_sale' | t | escape }}" data-sold-out="{{ 'yarn_project.kit_sold_out' | t | escape }}"
        data-pending="{{ 'yarn_project.kit_adding' | t | escape }}" data-success="{{ 'yarn_project.kit_added' | t | escape }}"
        data-incomplete="{{ 'yarn_project.kit_incomplete' | t | escape }}"
        data-error="{{ 'yarn_project.kit_add_error' | t | escape }}" data-uncertain="{{ 'yarn_project.kit_uncertain' | t | escape }}"
        data-add-url="{{ routes.cart_add_url }}" data-kit="{{ project.title.value | escape }}" data-kit-handle="{{ project.system.handle | escape }}">
        <div class="yk-buy__head">
          <h2 class="yk-h2">{{ 'yarn_project.kit_yarn_needed' | t }}</h2>
          {%- if ready_rows > 0 and ready_rows < yarn_rows -%}<span class="yk-tag yk-tag--partial">{{ 'yarn_project.kit_partial_tag' | t }}</span>{%- endif -%}
        </div>
        <ul class="yk-rows" role="list">
          {%- for component in project.components.value -%}
            {%- if component.component_type.value == '毛线' and component.variant.value != blank -%}
              {%- liquid
                assign row_variant = component.variant.value
                assign row_product = row_variant.product
                assign row_qty = component.quantity.value | default: 1
                assign row_image = component.image.value | default: row_variant.featured_image | default: row_product.featured_image
                assign row_ok = false
                if row_variant.available and row_variant.price > 0
                  assign row_ok = true
                endif
              -%}
              <li class="yk-row{% unless row_ok %} yk-row--out{% endunless %}" data-kit-row data-variant="{{ row_variant.id }}" data-price="{{ row_variant.price }}" data-available="{{ row_variant.available }}">
                <a class="yk-row__media" href="{{ row_variant.url }}" tabindex="-1" aria-hidden="true">
                  {%- if row_image != blank -%}{{ row_image | image_url: width: 200 | image_tag: width: 64, height: 64, loading: 'lazy', alt: '' }}{%- endif -%}
                </a>
                <div class="yk-row__info">
                  <p class="yk-row__title">
                    <a class="yk-row__name" href="{{ row_variant.url }}">{{ row_product.title | escape }}</a>
                    {%- if row_variant.price > 0 and row_variant.available == false -%}<span class="yk-tag" data-kit-stock>{{ 'yarn_project.kit_sold_out' | t }}</span>{%- endif -%}
                  </p>
                  {%- assign colour_index = -1 -%}
                  {%- for option in row_product.options_with_values -%}
                    {%- assign option_name = option.name | downcase -%}
                    {%- if option_name contains '色' or option_name contains 'color' or option_name contains 'colour' or option_name contains 'カラー' -%}{%- assign colour_index = forloop.index0 -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if colour_index >= 0 -%}
                    <label class="yk-colour" for="Colour-{{ section.id }}-{{ forloop.index }}">{{ 'yarn_project.kit_choose_colour' | t }}</label>
                    <select id="Colour-{{ section.id }}-{{ forloop.index }}" data-kit-colour>
                      {%- for alternative in row_product.variants -%}
                        {%- assign same_spec = true -%}
                        {%- for value in alternative.options -%}
                          {%- if forloop.index0 != colour_index and value != row_variant.options[forloop.index0] -%}{%- assign same_spec = false -%}{%- endif -%}
                        {%- endfor -%}
                        {%- if same_spec -%}
                          <option value="{{ alternative.id }}" data-price="{{ alternative.price }}" data-available="{{ alternative.available }}" data-url="{{ alternative.url }}" {% if alternative.id == row_variant.id %}selected{% endif %}{% unless alternative.available and alternative.price > 0 %} disabled{% endunless %}>{{ alternative.options[colour_index] | escape }}{% if alternative.price <= 0 %} — {{ 'yarn_project.kit_not_on_sale' | t }}{% elsif alternative.available == false %} — {{ 'yarn_project.kit_sold_out' | t }}{% endif %}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                  {%- elsif row_product.has_only_default_variant -%}
                    <span class="yk-row__note">{{ 'yarn_project.kit_qty_needed' | t: count: row_qty }} · {{ 'yarn_pdp.colour_pending' | t }}</span>
                  {%- else -%}
                    <span class="yk-row__variant">{{ row_variant.title | escape }}</span>
                  {%- endif -%}
                  <div class="yk-row__buy">
                    {%- if row_variant.price > 0 -%}<span class="yk-row__price" data-kit-price>{{ row_variant.price | money }}</span>{%- else -%}<span class="yk-soldout" data-kit-price>{{ 'yarn_project.kit_not_on_sale' | t }}</span>{%- endif -%}
                    <div class="yk-step" data-kit-stepper{% unless row_ok %} hidden{% endunless %}>
                      <button type="button" data-kit-step="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: row_product.title | escape }}"><span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span></button>
                      <input type="number" data-kit-qty name="quantity" value="{{ row_qty }}" min="1" inputmode="numeric" aria-label="{{ 'yarn_project.kit_qty_label' | t }} · {{ row_product.title | escape }}">
                      <button type="button" data-kit-step="1" aria-label="{{ 'products.product.quantity.increase' | t: product: row_product.title | escape }}"><span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span></button>
                    </div>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if ready_rows > 0 -%}
          <div class="yk-total" data-kit-total>
            <span data-kit-total-label>{{ 'yarn_project.kit_total' | t: count: ready_balls }}{{ tax_note }}</span>
            <strong data-kit-total-price>{{ ready_total | money }}</strong>
          </div>
          {%- if ready_rows == yarn_rows -%}
            <button type="button" class="yk-add-all" data-kit-add="all">{% if yarn_rows == 1 %}{{ 'yarn_project.kit_add' | t }}{% else %}{{ 'yarn_project.kit_add_all' | t }}{% endif %}</button>
          {%- else -%}
            <button type="button" class="yk-add-all" data-kit-add="available">{{ 'yarn_project.kit_add_available' | t: count: ready_balls }}</button>
            <p class="yk-note">{{ 'yarn_project.kit_partial_note' | t }}</p>
          {%- endif -%}
        {%- else -%}
          <div class="yk-blocked" role="status">
            <p>{% if missing_pending %}{{ 'yarn_project.kit_blocked_pending' | t: name: missing_name }}{% else %}{{ 'yarn_project.kit_blocked' | t: name: missing_name }}{% endif %}</p>
            {%- unless missing_pending -%}
              <a class="yk-blocked__ask" href="{{ kit_line }}"{% if settings.yarn_line_url != blank %} target="_blank" rel="noopener noreferrer"{% endif %}>{% if settings.yarn_line_url != blank %}{{ 'yarn_pdp.restock_ask_line' | t }}{% else %}{{ 'yarn_pdp.restock_ask_contact' | t }}{% endif %}</a>
            {%- endunless -%}
            <a class="yk-blocked__link" href="{% render 'yarn-local-url', url: list_url %}">{{ 'yarn_project.kit_other_kits' | t }} <span aria-hidden="true">→</span></a>
          </div>
        {%- endif -%}
        <p class="yk-status" data-kit-status role="status" aria-live="polite" hidden></p>
        <a class="yk-cart-link" data-kit-cart href="{{ routes.cart_url }}" hidden>{{ 'yarn_project.kit_view_cart' | t }}</a>
      </yarn-kit-buy>
      {%- if ready_rows > 0 -%}
        <yarn-kit-proxy class="yk-sticky" data-kit-sticky data-visible="false" inert>
          <div class="yk-sticky__bar" role="region" aria-label="{{ 'yarn_pdp.sticky_label' | t }}">
            {%- if project.cover.value != blank -%}<span class="yk-sticky__thumb" aria-hidden="true">{{ project.cover.value | image_url: width: 104 | image_tag: width: 52, height: 52, loading: 'lazy', alt: '' }}</span>{%- endif -%}
            <span class="yk-sticky__sum"><span data-kit-proxy-count>{{ 'yarn_project.kit_total' | t: count: ready_balls }}</span><strong data-kit-proxy-total>{{ ready_total | money }}</strong></span>
            <button type="button" class="yk-sticky__add" data-kit-proxy data-kit-proxy-short>{{ 'yarn_project.kit_sticky_add' | t }}</button>
          </div>
        </yarn-kit-proxy>
      {%- endif -%}
      {%- endif -%}

      {%- if yarn_rows > 0 -%}
        <section class="yk-section yk-get" aria-labelledby="KitGet-{{ section.id }}">
          <h2 class="yk-h2" id="KitGet-{{ section.id }}">{{ 'yarn_project.kit_get_heading' | t }}</h2>
          <div class="yk-get__grid">
            <div class="yk-get__box yk-get__box--in">
              <h3 class="yk-get__title">{{ 'yarn_project.kit_get_in' | t }}</h3>
              <ul class="yk-get__list" role="list">
                {%- for component in project.components.value -%}
                  {%- if component.component_type.value == '毛线' and component.variant.value != blank -%}
                    {%- assign get_qty = component.quantity.value | default: 1 -%}
                    <li>{% render 'yarn-spot-icon', name: 'yarn-ball', size: 52, base: 'cream' %}<span data-proof-content>{{ component.variant.value.product.title | escape }}<br>{{ 'yarn_project.kit_get_balls' | t: count: get_qty }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
            <div class="yk-get__box yk-get__box--bring">
              <h3 class="yk-get__title">{{ 'yarn_project.kit_self_supply' | t }}</h3>
              {%- if self_rows > 0 -%}
                <ul class="yk-self" role="list">
                  {%- for component in project.components.value -%}
                    {%- unless component.component_type.value == '毛线' and component.variant.value != blank -%}
                      <li><strong>{{ component.title.value | escape }}</strong>{%- if component.specification.value != blank -%}<span>{{ component.specification.value | escape }}</span>{%- endif -%}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <p class="yk-get__note">{{ 'yarn_project.kit_get_bring_default' | t }}</p>
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- endif -%}

      {%- if project.preparation.value != blank -%}
        <section class="yk-section">
          <h2 class="yk-h2">{{ 'yarn_project.kit_notes' | t }}</h2>
          <div class="yk-rte rte">{{ project.preparation | metafield_tag }}</div>
        </section>
      {%- endif -%}

      {%- if project.tutorial_url.value != blank -%}
        <section class="yk-tutorial">
          <svg class="yk-tutorial__wave" viewBox="0 0 390 28" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 28 C 65 0 130 0 195 14 S 325 28 390 4 L390 28 Z" fill="currentColor"/></svg>
          <h2 class="yk-h2">{{ 'yarn_project.kit_tutorial_how' | t }}</h2>
          <ol class="yk-steps">
            <li>{% render 'yarn-spot-icon', name: 'tote-bag', size: 60 %}<span>{{ 'yarn_project.kit_tutorial_step_1' | t }}</span></li>
            <li>{% render 'yarn-spot-icon', name: 'chat', size: 60 %}<span>{{ 'yarn_project.kit_tutorial_step_2' | t }}</span></li>
            <li>{% render 'yarn-spot-icon', name: 'pattern-book', size: 60 %}<span>{{ 'yarn_project.kit_tutorial_step_3' | t }}</span></li>
          </ol>
          <a class="yk-tutorial__link" href="{{ project.tutorial_url.value | escape }}" target="_blank" rel="noopener noreferrer">{{ 'yarn_project.kit_tutorial_link' | t }} <span aria-hidden="true">→</span></a>
        </section>
      {%- endif -%}
    </div>
  </div>

  {%- capture more_cards -%}
    {%- assign more_shown = 0 -%}
    {%- for other in shop.metaobjects.yarn_project.values -%}
      {%- if more_shown >= 4 -%}{%- break -%}{%- endif -%}
      {%- if other.system.handle != project.system.handle and other.cover.value != blank -%}
        {%- capture other_visible -%}{%- render 'yarn-kit-visible', project: other -%}{%- endcapture -%}
        {%- if other_visible == 'true' -%}
          {%- assign more_shown = more_shown | plus: 1 -%}
          {%- render 'yarn-project-pick-card', project: other -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if more_cards contains 'yx-project-pick' -%}
    <section class="yk-more">
      <h2 class="yk-h2">{{ 'yarn_project.kit_more' | t }}</h2>
      <div class="yx-project-picks">{{ more_cards }}</div>
    </section>
  {%- endif -%}
  {%- else -%}
    <div class="yk-empty"><h1>{{ 'yarn_project.missing' | t }}</h1><p>{{ 'yarn_project.missing_hint' | t }}</p></div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "材料包详情",
  "settings": [
    { "type": "paragraph", "content": "在 内容 → 元对象 → 编织作品 编辑：封面、标题、简介、难度、适合人群、配件（毛线类配件选 Variant 并填团数）、作品说明（preparation）、教程链接（tutorial_url 填官方 LINE）。" },
    { "type": "url", "id": "list_url", "label": "材料包列表页链接", "info": "面包屑「材料包」指向这里；留空为 /pages/kits。" }
  ]
}
{% endschema %}
