{% liquid
  assign starter_product = section.settings.product


  capture starter_heading
    render 'yarn-setting-text', settings: section.settings, key: 'heading'
  endcapture
  capture starter_text
    render 'yarn-setting-text', settings: section.settings, key: 'text'
  endcapture
  capture starter_label
    render 'yarn-setting-text', settings: section.settings, key: 'button_label', zh: 'label_zh', en: 'label_en'
  endcapture
  capture starter_fact_one
    render 'yarn-setting-text', settings: section.settings, key: 'fact_one'
  endcapture
  capture starter_fact_two
    render 'yarn-setting-text', settings: section.settings, key: 'fact_two'
  endcapture
  capture starter_fact_three
    render 'yarn-setting-text', settings: section.settings, key: 'fact_three'
  endcapture

  if starter_product != blank
    assign starter_url = starter_product.url
  else
    assign starter_url = routes.all_products_collection_url | append: '?discover_quantity=one-ball#discover-products'
  endif
%}

<section id="starter-project" class="yarn-starter color-{{ section.settings.color_scheme }} gradient" aria-labelledby="YarnStarterHeading-{{ section.id }}">
  <div class="page-width">
    <div class="yarn-starter__card">
      <a class="yarn-starter__media" href="{{ starter_url }}" aria-label="{{ starter_label | escape }}">
        {% if starter_product.featured_media != blank %}
          {{ starter_product.featured_media
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '420, 640, 900, 1200, 1400',
              sizes: '(min-width: 990px) 52vw, 100vw',
              alt: starter_product.featured_media.alt
          }}
        {% else %}
          <div class="yarn-starter__placeholder" aria-hidden="true">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </a>

      <div class="yarn-starter__copy">
        <h2 id="YarnStarterHeading-{{ section.id }}">{{ starter_heading | escape }}</h2>
        <div class="yarn-starter__text rte">{{ starter_text }}</div>

        <ul class="yarn-starter__facts" role="list">
          <li>{{ starter_fact_one | escape }}</li>
          <li>{{ starter_fact_two | escape }}</li>
          <li>{{ starter_fact_three | escape }}</li>
        </ul>

        <div class="yarn-starter__action">
          <a href="{{ starter_url }}">{{ starter_label | escape }} <span aria-hidden="true">→</span></a>
          {% if starter_product != blank %}
            <span>{{ starter_product.price | money }}</span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .yarn-starter.yarn-starter {
    padding: clamp(72px, 8vw, 118px) 0;
    background: var(--yarn-bg-page);
  }

  .yarn-starter__card {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    overflow: hidden;
    border: 1px solid var(--yarn-shadow-soft);
    border-radius: 28px;
    background: var(--yarn-bg-surface);
    box-shadow: 0 20px 54px var(--yarn-shadow-soft);
  }

  .yarn-starter__media {
    display: block;
    min-height: 580px;
    overflow: hidden;
    background: var(--yarn-tint-blush);
  }

  .yarn-starter__media img,
  .yarn-starter__placeholder,
  .yarn-starter__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .yarn-starter__media img {
    display: block;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(.16, 1, .3, 1);
  }

  .yarn-starter__media:hover img { transform: scale(1.025); }

  .yarn-starter__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(44px, 6vw, 86px);
  }

  .yarn-starter__eyebrow {
    margin: 0 0 20px;
    color: var(--yarn-action);
    font-size: var(--yarn-fs-13);
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  .yarn-starter__copy h2 {
    max-width: 10em;
    margin: 0;
    color: var(--yarn-text-on-cta);
    font-size: var(--yarn-fs-display);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: 0.02em;
  }

  .yarn-starter__text {
    max-width: 39rem;
    margin-top: 22px;
    color: var(--yarn-text-muted);
    font-size: var(--yarn-fs-16);
    line-height: 1.85;
  }

  .yarn-starter__text p { margin: 0; }

  .yarn-starter__facts {
    display: grid;
    margin: 32px 0 0;
    padding: 0;
    border-top: 1px solid var(--yarn-border-subtle);
    list-style: none;
  }

  .yarn-starter__facts li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--yarn-border-subtle);
    color: var(--yarn-text-primary);
    font-size: var(--yarn-fs-14);
  }

  .yarn-starter__facts li span {
    color: var(--yarn-text-muted);
    font-size: var(--yarn-fs-12);
    letter-spacing: 0.08em;
  }

  .yarn-starter__action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 34px;
  }

  .yarn-starter__action a {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    gap: 22px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--yarn-cta-bg);
    color: var(--yarn-text-on-cta);
    font-size: var(--yarn-fs-14);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, transform 260ms cubic-bezier(.16, 1, .3, 1);
  }

  .yarn-starter__action a:hover { background: var(--yarn-cta-hover); transform: translateY(-2px); }
  .yarn-starter__action > span { color: var(--yarn-text-secondary); font-size: var(--yarn-fs-15); }

  @media screen and (max-width: 989px) {
    .yarn-starter__card { grid-template-columns: minmax(0, 0.94fr) minmax(330px, 1.06fr); }
    .yarn-starter__media { min-height: 610px; }
    .yarn-starter__copy { padding: clamp(34px, 4.8vw, 46px); }
    .yarn-starter__copy h2 { max-width: 11em; font-size: var(--yarn-fs-section); }
  }

  @media screen and (max-width: 749px) {
    .yarn-starter__card { grid-template-columns: 1fr; }
    .yarn-starter__media { min-height: min(84vw, 520px); }
  }

  @media screen and (max-width: 599px) {
    .yarn-starter { padding: 56px 0 68px; }
    .yarn-starter__card { border-radius: 20px; }
    .yarn-starter__media { min-height: 84vw; }
    .yarn-starter__copy { padding: 30px 24px 34px; }
    .yarn-starter__action { align-items: flex-start; flex-direction: column; gap: 14px; }
  }
{% endstylesheet %}

