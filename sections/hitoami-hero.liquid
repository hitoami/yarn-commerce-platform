{% comment %}
  首页首屏:整幅场景轮播,标题、说明与按钮压在左侧留白处(桌面对齐 1200 内容轴);圆点居中在底部的白色胶囊里(#126 Claude Design 1a);底边是一道波浪。
  作为首页第一个 section 时,页头透明地叠在图上(规则在 hitoami-hero.css)。
  与首屏下方的导览条互不关联:切换幻灯片不影响导览条,导览条也不控制幻灯片。
  场景图可在每张幻灯片上传(桌面 / 手机),未上传时用内置的三张氛围图(来源见 docs/design/approved/home-scheme-c.source.md)。
  三语文案经 yarn-setting-text 取:纯键名为日文默认,_zh/_en 为中英设置。
{% endcomment %}
{{ 'hitoami-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hitoami-hero.js' | asset_url }}" defer="defer"></script>

<hitoami-hero class="hitoami-hero-root">
  {% if section.blocks.size > 0 %}
    <section class="hitoami-hero" aria-label="{{ 'sections.slideshow.carousel' | t }}" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}">
      <div class="hitoami-slides">
        {% for block in section.blocks %}
          {% liquid
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image | default: desktop_image
            assign desktop_image = desktop_image | default: mobile_image
            assign desktop_asset = 'hitoami-kit-wide.webp'
            assign mobile_asset = 'hitoami-room-mobile.webp'
            if block.settings.scene == 'yarn'
              assign desktop_asset = 'hitoami-yarn-wide.webp'
              assign mobile_asset = 'hitoami-yarn-mobile.webp'
            elsif block.settings.scene == 'finished'
              assign desktop_asset = 'hitoami-finished-wide.webp'
              assign mobile_asset = 'hitoami-finished-mobile.webp'
            endif
            capture heading
              render 'yarn-setting-text', settings: block.settings, key: 'heading'
            endcapture
            capture text
              render 'yarn-setting-text', settings: block.settings, key: 'text'
            endcapture
            capture cta
              render 'yarn-setting-text', settings: block.settings, key: 'cta'
            endcapture
            assign target = block.settings.link
            if target == blank
              assign target = collections['knit-kits'].url | default: routes.all_products_collection_url
              if block.settings.scene == 'yarn'
                assign target = collections['yarn'].url | default: routes.all_products_collection_url
              elsif block.settings.scene == 'finished'
                assign target = collections['finished-goods'].url | default: routes.all_products_collection_url
              endif
            endif
          %}
          <article id="HitoamiSlide-{{ block.id }}" class="hitoami-slide hitoami-slide--{{ block.settings.tone }}{% if desktop_image == blank %} hitoami-slide--default-scene{% endif %}" data-scene="{{ block.settings.scene }}" data-slide data-block-id="{{ block.id }}" aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {% unless forloop.first %}hidden inert{% endunless %} {{ block.shopify_attributes }}>
            <picture class="hitoami-scene" style="--scene-focus: {{ block.settings.focus }}%;">
              {% if mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="100vw">
              {% else %}
                <source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">
              {% endif %}
              {% if desktop_image != blank %}
                <img src="{{ desktop_image | image_url: width: 2560 }}" srcset="{{ desktop_image | image_url: width: 900 }} 900w, {{ desktop_image | image_url: width: 1600 }} 1600w, {{ desktop_image | image_url: width: 2560 }} 2560w, {{ desktop_image | image_url: width: 3840 }} 3840w" sizes="100vw" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% else %}
                <img src="{{ desktop_asset | asset_url }}" width="1672" height="941" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% endif %}
            </picture>
            <div class="hitoami-copy">
              {% if forloop.first %}<h1 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h1>{% else %}<h2 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h2>{% endif %}
              {% if text != blank %}<p class="hitoami-subtitle">{{ text | escape }}</p>{% endif %}
              {% if cta != blank %}<a class="hitoami-cta" href="{{ target }}">{{ cta | escape }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="hitoami-controls" hidden>
          <div class="hitoami-dots">
            {% for block in section.blocks %}<button type="button" data-page="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}" aria-controls="HitoamiSlide-{{ block.id }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>{% endfor %}
          </div>
        </div>
      {% endif %}
      <span class="visually-hidden" data-slide-status aria-live="polite" aria-atomic="true"></span>
      <svg class="hitoami-wave" viewBox="0 0 1440 52" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 25 C180 -10 340 52 560 28 S850 0 1020 25 S1260 45 1440 14 V52 H0Z"/></svg>
    </section>
  {% endif %}

</hitoami-hero>

{% schema %}
{
  "name": "首屏 · 手作小屋轮播",
  "tag": "section",
  "class": "section hitoami-hero-section",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "活动幻灯片",
      "settings": [
        {
          "type": "select",
          "id": "scene",
          "label": "默认氛围图",
          "info": "未上传图片时使用对应的内置场景；按钮链接留空时进入对应集合。",
          "default": "kit",
          "options": [
            {
              "value": "kit",
              "label": "手作桌(编织包)"
            },
            {
              "value": "yarn",
              "label": "毛线柜(毛线)"
            },
            {
              "value": "finished",
              "label": "成品角(成品)"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "桌面背景图",
          "info": "建议至少 2560px 宽的横图，左侧为标题留白；高密度大屏建议 3840px。"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "手机背景图",
          "info": "不填则使用桌面图；建议竖图，上部留白供标题显示。"
        },
        {
          "type": "range",
          "id": "focus",
          "label": "图片水平焦点",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "select",
          "id": "tone",
          "label": "文字颜色",
          "default": "dark",
          "options": [
            {
              "value": "dark",
              "label": "深色文字（浅图）"
            },
            {
              "value": "light",
              "label": "浅色文字（深图）"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "日文 · 标题",
          "default": "ここで、\n毎日を少しゆっくりと。"
        },
        {
          "type": "textarea",
          "id": "heading_zh",
          "label": "中文 · 标题",
          "default": "来这里，\n把日子过慢一点。"
        },
        {
          "type": "textarea",
          "id": "heading_en",
          "label": "英文 · 标题",
          "default": "Come in.\nTake life a stitch slower."
        },
        {
          "type": "text",
          "id": "text",
          "label": "日文 · 说明",
          "default": "材料と編み図を、ゆっくり選ぼう。"
        },
        {
          "type": "text",
          "id": "text_zh",
          "label": "中文 · 说明",
          "default": "材料与图解，一起慢慢挑。"
        },
        {
          "type": "text",
          "id": "text_en",
          "label": "英文 · 说明",
          "default": "Find your yarn, your pattern, your pace."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "日文 · 按钮",
          "default": "編みキットを見る"
        },
        {
          "type": "text",
          "id": "cta_zh",
          "label": "中文 · 按钮",
          "default": "看看编织包"
        },
        {
          "type": "text",
          "id": "cta_en",
          "label": "英文 · 按钮",
          "default": "Explore the kits"
        },
        {
          "type": "url",
          "id": "link",
          "label": "按钮链接",
          "info": "留空时进入对应的毛线、材料包或成品集合；可链接任意活动、商品或内容页。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "首屏 · 手作小屋轮播",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "scene": "yarn",
            "focus": 50,
            "tone": "dark",
            "heading": "ここで、\n毎日を少しゆっくりと。",
            "heading_zh": "来这里，\n把日子过慢一点。",
            "heading_en": "Come in.\nTake life a stitch slower.",
            "text": "色と手ざわりから、お気に入りを探そう。",
            "text_zh": "从颜色与手感开始，找到自己的节奏。",
            "text_en": "Explore colour and texture at your own pace.",
            "cta": "毛糸を選ぶ",
            "cta_zh": "挑选毛线",
            "cta_en": "Explore the yarn"
          }
        },
        {
          "type": "slide",
          "settings": {
            "scene": "kit",
            "focus": 50,
            "tone": "dark",
            "heading": "キットを開いて、\n最初のひと目から。",
            "heading_zh": "打开编织包，\n从第一针慢慢开始。",
            "heading_en": "Open a kit.\nBegin with one stitch.",
            "text": "材料と編み図を、ゆっくり選ぼう。",
            "text_zh": "材料与图解，一起慢慢挑。",
            "text_en": "Find your yarn, your pattern, your pace.",
            "cta": "編みキットを見る",
            "cta_zh": "看看编织包",
            "cta_en": "Explore the kits"
          }
        },
        {
          "type": "slide",
          "settings": {
            "scene": "finished",
            "focus": 50,
            "tone": "dark",
            "heading": "手づくりのぬくもりを、\n毎日の暮らしへ。",
            "heading_zh": "把手作的温柔，\n带进日常。",
            "heading_en": "Handmade warmth.\nA place in your everyday.",
            "text": "お気に入りのひと品を、あなたのもとへ。",
            "text_zh": "挑一件喜欢的手作，陪伴每一天。",
            "text_en": "Find a handmade piece to make your days a little warmer.",
            "cta": "完成品を見る",
            "cta_zh": "挑选成品",
            "cta_en": "Explore finished pieces"
          }
        }
      ]
    }
  ]
}
{% endschema %}
