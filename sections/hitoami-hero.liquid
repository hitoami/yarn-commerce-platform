{% comment %}
  首页首屏:整幅场景轮播,标题、说明与文字链压在左侧留白处(桌面对齐 1200 内容轴);底部居中是一条胶囊切换,写出每张的名字和「01 / 03」(#274,取代圆点);底边是一道波浪。
  #131 活动图:标题、说明与按钮都留空时只显示图片(不加遮罩),填了链接则整张图可点;选「浅色占位」时未上传图片显示浅色占位块。
  作为首页第一个 section 时,页头透明地叠在图上(规则在 hitoami-hero.css)。
  与首屏下方的导览条互不关联:切换幻灯片不影响导览条,导览条也不控制幻灯片。
  场景图可在每张幻灯片上传(桌面 / 手机),未上传时用内置氛围图;#274 起毛线、作品用线、本季主推三张换成同一个窗边角落的系列照(来源见同名 .source.json 与 docs/design/approved/274-hero-window.source.md)。
  胶囊上的名字取本张的「切换名称」设置,留空时按场景用 Theme locales(毛线 / 作品用线 / 本季 / 成品),再不行显示序号。
  三语文案经 yarn-setting-text 取:纯键名为日文默认,_zh/_en 为中英设置。
{% endcomment %}
{{ 'hitoami-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hitoami-hero.js' | asset_url }}" defer="defer"></script>

<hitoami-hero class="hitoami-hero-root{% if section.settings.catalog_layout %} hitoami-hero--catalog{% endif %}">
  {% if section.settings.catalog_layout %}{{ 'yarn-home-mobile.css' | asset_url | stylesheet_tag }}{% endif %}
  {% if section.blocks.size > 0 %}
    <section class="hitoami-hero" aria-label="{{ 'sections.slideshow.carousel' | t }}" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}">
      <div class="hitoami-slides">
        {% for block in section.blocks %}
          {% liquid
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image | default: desktop_image
            assign desktop_image = desktop_image | default: mobile_image
            assign desktop_asset = 'hitoami-kit-wide.webp'
            assign mobile_asset = 'hitoami-room-mobile.webp'
            if block.settings.scene == 'yarn'
              assign desktop_asset = 'hitoami-yarn-wide.webp'
              assign mobile_asset = 'hitoami-yarn-mobile.webp'
            elsif block.settings.scene == 'finished'
              assign desktop_asset = 'hitoami-finished-wide.webp'
              assign mobile_asset = 'hitoami-finished-mobile.webp'
            elsif block.settings.scene == 'season'
              assign desktop_asset = 'hitoami-season-wide.webp'
              assign mobile_asset = 'hitoami-season-mobile.webp'
            endif
            capture heading
              render 'yarn-setting-text', settings: block.settings, key: 'heading'
            endcapture
            capture text
              render 'yarn-setting-text', settings: block.settings, key: 'text'
            endcapture
            capture cta
              render 'yarn-setting-text', settings: block.settings, key: 'cta'
            endcapture
            assign image_only = false
            if heading == blank and text == blank and cta == blank
              assign image_only = true
            endif
            assign placeholder = false
            if block.settings.scene == 'placeholder' and desktop_image == blank
              assign placeholder = true
            endif
            assign target = block.settings.link
            if target == blank and image_only == false
              assign target = pages['kits'].url | default: routes.all_products_collection_url
              if block.settings.scene == 'yarn'
                assign target = collections['yarn'].url | default: routes.all_products_collection_url
              elsif block.settings.scene == 'finished'
                assign target = collections['finished-goods'].url | default: routes.all_products_collection_url
              elsif block.settings.scene == 'season'
                assign target = pages['season'].url | default: routes.all_products_collection_url
              endif
            endif
          %}
          <article id="HitoamiSlide-{{ block.id }}" class="hitoami-slide hitoami-slide--{{ block.settings.tone }}{% if desktop_image == blank and placeholder == false %} hitoami-slide--default-scene{% endif %}{% if image_only %} hitoami-slide--image-only{% endif %}" data-scene="{{ block.settings.scene }}" data-slide data-block-id="{{ block.id }}" aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {% unless forloop.first %}hidden inert{% endunless %} {{ block.shopify_attributes }}>
            {%- if image_only and forloop.first -%}<h1 class="visually-hidden">{{ shop.name | escape }}</h1>{%- endif -%}
            {%- if image_only and target != blank -%}<a class="hitoami-slide__link" href="{{ target }}" aria-label="{{ forloop.index }} / {{ section.blocks.size }}">{%- endif -%}
            {%- if placeholder -%}
              <div class="hitoami-scene hitoami-scene--placeholder" aria-hidden="true"></div>
            {%- else -%}
            <picture class="hitoami-scene" style="--scene-focus: {{ block.settings.focus }}%;">
              {% if mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="100vw">
              {% else %}
                <source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">
              {% endif %}
              {% if desktop_image != blank %}
                <img src="{{ desktop_image | image_url: width: 2560 }}" srcset="{{ desktop_image | image_url: width: 900 }} 900w, {{ desktop_image | image_url: width: 1600 }} 1600w, {{ desktop_image | image_url: width: 2560 }} 2560w, {{ desktop_image | image_url: width: 3840 }} 3840w" sizes="100vw" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% else %}
                <img src="{{ desktop_asset | asset_url }}" width="1536" height="1024" alt="" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {% endif %}
            </picture>
            {%- endif -%}
            {%- if image_only and target != blank -%}</a>{%- endif -%}
            {%- unless image_only -%}
            <div class="hitoami-copy">
              {% if forloop.first %}<h1 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h1>{% else %}<h2 class="hitoami-heading">{{ heading | escape | newline_to_br }}</h2>{% endif %}
              {% if text != blank %}<p class="hitoami-subtitle">{{ text | escape }}</p>{% endif %}
              {% if cta != blank %}<a class="hitoami-cta" href="{{ target }}">{{ cta | escape }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>{% endif %}
            </div>
            {%- endunless -%}
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="hitoami-controls" hidden>
          <div class="hitoami-tabs" role="group" aria-label="{{ 'hitoami_home.hero_tabs' | t }}">
            {%- for block in section.blocks -%}
              {%- liquid
                capture tab
                  render 'yarn-setting-text', settings: block.settings, key: 'label', allow_blank: true
                endcapture
                if tab == blank
                  case block.settings.scene
                    when 'yarn', 'kit', 'season', 'finished'
                      assign tab_key = 'hitoami_home.hero_tab_' | append: block.settings.scene
                      assign tab = tab_key | t
                    else
                      assign tab = forloop.index
                  endcase
                endif
              -%}
              <button type="button" class="hitoami-tab" data-page="{{ forloop.index0 }}" aria-controls="HitoamiSlide-{{ block.id }}" {% if forloop.first %}aria-current="true"{% endif %}>{{ tab | strip | escape }}</button>
            {%- endfor -%}
            <span class="hitoami-count" aria-hidden="true"><span data-slide-number>01</span> / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
          </div>
        </div>
      {% endif %}
      <span class="visually-hidden" data-slide-status aria-live="polite" aria-atomic="true"></span>
      <svg class="hitoami-wave" viewBox="0 0 1440 52" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 25 C180 -10 340 52 560 28 S850 0 1020 25 S1260 45 1440 14 V52 H0Z"/></svg>
    </section>
  {% endif %}

</hitoami-hero>

{% schema %}
{
  "name": "首屏 · 手作小屋轮播",
  "tag": "section",
  "class": "section hitoami-hero-section",
  "max_blocks": 8,
  "settings": [{"type":"checkbox","id":"catalog_layout","label":"首屏下方的手机目录布局","default":false}],
  "blocks": [
    {
      "type": "slide",
      "name": "活动幻灯片",
      "settings": [
        {
          "type": "select",
          "id": "scene",
          "label": "默认氛围图",
          "info": "未上传图片时使用对应的内置场景；链接留空时进入对应页面（毛线集合、作品页、本季主推或成品集合）。活动图选「浅色占位」，上传图片前显示浅色块。",
          "default": "kit",
          "options": [
            {
              "value": "placeholder",
              "label": "浅色占位(活动图)"
            },
            {
              "value": "kit",
              "label": "手作桌(编织包)"
            },
            {
              "value": "yarn",
              "label": "毛线柜(毛线)"
            },
            {
              "value": "finished",
              "label": "成品角(成品)"
            },
            {
              "value": "season",
              "label": "窗边毛线篮(本季主推)"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "桌面背景图",
          "info": "建议至少 2560px 宽的横图，左侧为标题留白；高密度大屏建议 3840px。"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "手机背景图",
          "info": "不填则使用桌面图；建议竖图，上部留白供标题显示。"
        },
        {
          "type": "range",
          "id": "focus",
          "label": "图片水平焦点",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "select",
          "id": "tone",
          "label": "文字颜色",
          "default": "dark",
          "options": [
            {
              "value": "dark",
              "label": "深色文字（浅图）"
            },
            {
              "value": "light",
              "label": "浅色文字（深图）"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "日文 · 标题",
          "default": "ここで、\n毎日を少しゆっくりと。"
        },
        {
          "type": "textarea",
          "id": "heading_zh",
          "label": "中文 · 标题",
          "default": "来这里，\n把日子过慢一点。"
        },
        {
          "type": "textarea",
          "id": "heading_en",
          "label": "英文 · 标题",
          "default": "Come in.\nTake life a stitch slower."
        },
        {
          "type": "text",
          "id": "text",
          "label": "日文 · 说明",
          "default": "材料と編み図を、ゆっくり選ぼう。"
        },
        {
          "type": "text",
          "id": "text_zh",
          "label": "中文 · 说明",
          "default": "材料与图解，一起慢慢挑。"
        },
        {
          "type": "text",
          "id": "text_en",
          "label": "英文 · 说明",
          "default": "Find your yarn, your pattern, your pace."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "日文 · 文字链",
          "default": "編みキットを見る"
        },
        {
          "type": "text",
          "id": "cta_zh",
          "label": "中文 · 文字链",
          "default": "看看编织包"
        },
        {
          "type": "text",
          "id": "cta_en",
          "label": "英文 · 文字链",
          "default": "Explore the kits"
        },
        {
          "type": "text",
          "id": "label",
          "label": "日文 · 切换名称",
          "info": "首屏底部胶囊上这张的名字。留空时按默认氛围图显示：毛糸 / 作品と糸 / 今季 / 完成品（中文：毛线 / 作品用线 / 本季 / 成品）。"
        },
        {
          "type": "text",
          "id": "label_zh",
          "label": "中文 · 切换名称"
        },
        {
          "type": "text",
          "id": "label_en",
          "label": "英文 · 切换名称"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接",
          "info": "有文字链时是它的目标，留空进入对应页面。标题、说明、文字链都留空时只显示图片，填了链接则整张图可点。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "首屏 · 手作小屋轮播",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "scene": "yarn",
            "focus": 50,
            "tone": "dark",
            "heading": "ひと玉ずつ、\n選ぶ楽しみ。",
            "heading_zh": "一团一团，\n慢慢挑。",
            "heading_en": "Choose yarn,\none ball at a time.",
            "text": "グラデーションや段染め、モヘヤ、ループヤーンなど。hitoamiは毛糸の専門店です。",
            "text_zh": "渐变、段染、马海毛、圈圈纱……这里是毛线专门店 hitoami。",
            "text_en": "Gradient and variegated yarns, mohair, bouclé and more. Welcome to hitoami, a specialist yarn shop.",
            "cta": "毛糸を見る",
            "cta_zh": "浏览毛线",
            "cta_en": "Browse yarn"
          }
        },
        {
          "type": "slide",
          "settings": {
            "scene": "kit",
            "focus": 50,
            "tone": "dark",
            "heading": "編みたいものから、\n糸を選ぶ。",
            "heading_zh": "从想织的作品，\n找到想用的线。",
            "heading_en": "Start with\nyour next project.",
            "text": "作品ごとに、使う毛糸と玉数を紹介しています。ねこのあみぐるみは準備中です。",
            "text_zh": "每个作品都写明用哪款毛线、用几团。小猫玩偶作品准备中。",
            "text_en": "Each project lists its yarn and ball count. The cat amigurumi is coming soon.",
            "cta": "作品と使う毛糸を見る",
            "cta_zh": "看作品与用线",
            "cta_en": "Explore projects and yarn"
          }
        },
        {
          "type": "slide",
          "settings": {
            "scene": "season",
            "focus": 50,
            "tone": "dark",
            "heading": "秋冬の編みものに、\nあたたかな色を。",
            "heading_zh": "秋冬，\n织一点温暖的颜色。",
            "heading_en": "Warm colors\nfor autumn and winter.",
            "text": "秋冬におすすめの毛糸をご紹介します。",
            "text_zh": "看看本季推荐的秋冬毛线。",
            "text_en": "Explore our yarn picks for the season.",
            "cta": "今季のおすすめを見る",
            "cta_zh": "看本季主推",
            "cta_en": "Explore seasonal yarn picks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
