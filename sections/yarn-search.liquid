{{ 'yarn-project.css' | asset_url | stylesheet_tag }}
{{ 'yarn-discovery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-search.js' | asset_url }}" defer="defer"></script>
<yarn-discovery-search class="yd-search" data-search-url="{{ routes.search_url }}" data-section-id="{{ section.id }}">
  <header class="yd-search__bar">
    <a class="yd-search__back" href="{{ routes.root_url }}#shop-by-project" data-search-back aria-label="{{ 'yarn_discovery.back' | t }}">{{ 'icon-arrow.svg' | inline_asset_content }}</a>
    <h1 data-search-title data-title="{{ 'yarn_discovery.search' | t }}" data-favorites-title="{{ 'yarn_discovery.favorites' | t }}">{{ 'yarn_discovery.search' | t }}</h1>
    <a class="yd-search__favorites" href="{{ routes.search_url }}?browse=favorites" data-favorites-link>{{ 'yarn_discovery.favorites' | t }}</a>
  </header>
  <div class="yd-search__toolbar">
  <form class="yd-search__form" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
    <div class="yd-search__field">
      <button class="yd-search__icon" type="submit" aria-label="{{ 'yarn_discovery.search' | t }}">{{ 'icon-search.svg' | inline_asset_content }}</button>
      <div>
        <label class="visually-hidden" for="DiscoveryQuery-{{ section.id }}">{{ 'yarn_discovery.search_placeholder' | t }}</label>
        <input id="DiscoveryQuery-{{ section.id }}" name="q" type="search" value="{{ search.terms | escape }}" placeholder="{{ 'yarn_discovery.search_placeholder' | t }}" autocomplete="off">
        <p>{{ 'yarn_discovery.search_scope' | t }}</p>
      </div>
      <button class="yd-search__icon" type="button" data-search-clear aria-label="{{ 'yarn_discovery.clear_search' | t }}" {% if search.terms == blank %}hidden{% endif %}>{{ 'icon-close.svg' | inline_asset_content }}</button>
    </div>
    <button class="yd-search__icon yd-search__filter" type="button" data-search-filter aria-label="{{ 'yarn_discovery.filters' | t }}" aria-haspopup="dialog" aria-controls="DiscoveryFilters-{{ section.id }}">{{ 'icon-filter.svg' | inline_asset_content }}</button>
  </form>
  <fieldset class="yd-search__purchase">
    <legend class="visually-hidden">{{ 'yarn_project.purchase_filter' | t }}</legend>
    <span class="yd-search__purchase-label" aria-hidden="true">{{ 'yarn_project.purchase_filter' | t }}</span>
    <label><input class="visually-hidden" type="radio" name="inline_purchase" value="" data-inline-purchase checked><span>{{ 'yarn_project.all' | t }}</span></label>
    {% assign inline_purchase_filters = 'finished,materials,inspiration' | split: ',' %}
    {% for purchase_filter in inline_purchase_filters %}
      <label><input class="visually-hidden" type="radio" name="inline_purchase" value="{{ purchase_filter }}" data-inline-purchase><span>{{ purchase_filter | prepend: 'yarn_project.tag_' | t }}</span></label>
    {% endfor %}
  </fieldset>
  </div>
  <nav class="yd-search__categories" aria-label="{{ 'yarn_project.category' | t }}">
    {% assign category_keys = 'all,bag,scarf,home,toy' | split: ',' %}
    {% for key in category_keys %}
      {% liquid
        assign category_asset = 'yarn-category-' | append: key | append: '-approved.png'
        assign category_label_key = 'yarn_project.category_' | append: key
        if key == 'all'
          assign category_asset = 'mewool-hero-yarn-node.png'
          assign category_label_key = 'yarn_project.all'
        elsif key == 'home'
          assign category_label_key = 'yarn_project.category_living'
        endif
      %}
      <button class="yd-search__category" type="button" data-search-category="{% unless key == 'all' %}{{ key }}{% endunless %}" aria-pressed="false">
        <img src="{{ category_asset | asset_url }}" alt="" width="112" height="112" loading="eager">
        <span>{{ category_label_key | t }}</span>
      </button>
    {% endfor %}
  </nav>
  <section class="yd-search__default" data-search-default>
    <h2>{{ 'yarn_discovery.try_searching' | t }}</h2>
    <div class="yd-search__examples">
      {% assign example_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'suggestion' and block.settings.query != blank %}
          <a href="{{ routes.search_url }}?q={{ block.settings.query | url_encode }}" data-search-suggestion="{{ block.settings.query | escape }}" {{ block.shopify_attributes }}>{{ block.settings.query | escape }}</a>
          {% assign example_count = example_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if example_count == 0 %}
        {% for index in (1..3) %}
          {% assign example_key = 'yarn_discovery.example_' | append: index %}
          {% assign example_query = example_key | t %}
          <a href="{{ routes.search_url }}?q={{ example_query | url_encode }}" data-search-suggestion="{{ example_query | escape }}">{{ example_query }}</a>
        {% endfor %}
      {% endif %}
    </div>
  </section>
  <p class="yd-search__status" data-search-loading role="status" hidden>{{ 'yarn_project.loading' | t }}</p>
  <p class="visually-hidden" data-search-count aria-live="polite" data-count-template="{{ 'yarn_discovery.result_count' | t: projects: '[projects]', products: '[products]' | escape }}"></p>
  <section class="yd-search__error" data-search-error hidden role="alert">
    <h2>{{ 'yarn_discovery.load_error' | t }}</h2>
    <p>{{ 'yarn_discovery.load_error_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-search-retry>{{ 'yarn_project.retry' | t }}</button>
  </section>
  <section class="yd-search__empty" data-search-empty hidden>
    <h2>{{ 'yarn_discovery.empty' | t }}</h2>
    <p>{{ 'yarn_discovery.empty_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-search-reset>{{ 'yarn_discovery.start_over' | t }}</button>
  </section>
  <section class="yd-search__empty" data-favorites-empty hidden>
    <h2>{{ 'yarn_discovery.favorites_empty' | t }}</h2>
    <p>{{ 'yarn_discovery.favorites_empty_hint' | t }}</p>
    <a class="yd-search__action" href="{{ routes.root_url }}#shop-by-project">{{ 'yarn_discovery.discover_projects' | t }}</a>
  </section>
  <section class="yd-search__empty" data-favorites-login hidden>
    <h2>{{ 'yarn_discovery.login_title' | t }}</h2>
    <p>{{ 'yarn_discovery.login_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-favorites-login-button>{{ 'customer.log_in' | t }}</button>
  </section>
  <section class="yd-search__empty" data-favorites-unavailable hidden>
    <h2>{{ 'yarn_discovery.favorites' | t }}</h2>
    <p>{{ 'yarn_discovery.favorites_unavailable' | t }}</p>
    <a class="yd-search__action" href="{{ routes.root_url }}#shop-by-project">{{ 'yarn_discovery.discover_projects' | t }}</a>
  </section>
  <div data-search-results hidden>
    <section class="yd-search__group" data-search-group="project" aria-labelledby="DiscoveryProjects-{{ section.id }}">
      <h2 id="DiscoveryProjects-{{ section.id }}">{{ 'yarn_discovery.related_projects' | t }}</h2>
      {% paginate shop.metaobjects.yarn_project.values by 250 %}
        <div class="yd-search__projects" data-search-catalog="project">
          {% for project in shop.metaobjects.yarn_project.values %}
            {% render 'yarn-project-card', project: project, compact: true, search_card: true %}
          {% endfor %}
        </div>
        {% if paginate.next %}<a data-search-next="project" href="{{ paginate.next.url | escape }}&amp;section_id={{ section.id | url_encode }}" hidden>{{ 'yarn_project.more' | t }}</a>{% endif %}
      {% endpaginate %}
    </section>
    <section class="yd-search__group" data-search-group="product" aria-labelledby="DiscoveryProducts-{{ section.id }}">
      <h2 id="DiscoveryProducts-{{ section.id }}">{{ 'yarn_discovery.related_products' | t }}</h2>
      {% paginate collections.all.products by 250 %}
        <div class="yd-search__products" data-search-catalog="product">
          {% for discovery_product in collections.all.products %}
            {% render 'yarn-discovery-product-card', product: discovery_product, search_card: true %}
          {% endfor %}
        </div>
        {% if paginate.next %}<a data-search-next="product" href="{{ paginate.next.url | escape }}&amp;section_id={{ section.id | url_encode }}" hidden>{{ 'yarn_project.more' | t }}</a>{% endif %}
      {% endpaginate %}
    </section>
  </div>
  <dialog id="DiscoveryFilters-{{ section.id }}" class="yd-search__dialog" aria-labelledby="DiscoveryFiltersTitle-{{ section.id }}">
    <form method="dialog" data-filter-form>
      <header>
        <h2 id="DiscoveryFiltersTitle-{{ section.id }}">{{ 'yarn_discovery.filters' | t }}</h2>
        <button class="yd-search__icon" type="button" data-filter-close aria-label="{{ 'accessibility.close' | t }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
      </header>
      <fieldset class="yd-search__options">
        <legend class="visually-hidden">{{ 'yarn_project.purchase_filter' | t }}</legend>
        <label class="yd-search__option"><input type="radio" name="purchase" value="" checked> {{ 'yarn_project.all' | t }}</label>
        {% assign purchase_filters = 'finished,materials,inspiration' | split: ',' %}
        {% for purchase_filter in purchase_filters %}
          <label class="yd-search__option"><input type="radio" name="purchase" value="{{ purchase_filter }}"> {{ purchase_filter | prepend: 'yarn_project.tag_' | t }}</label>
        {% endfor %}
      </fieldset>
      <footer>
        <button class="yd-search__reset" type="button" data-filter-reset>{{ 'yarn_discovery.reset_filters' | t }}</button>
        <button class="yd-search__action" type="submit">{{ 'yarn_discovery.show_results' | t }}</button>
      </footer>
    </form>
  </dialog>
  <noscript><p>{{ 'yarn_discovery.javascript_required' | t }} <a href="{{ routes.all_products_collection_url }}">{{ 'yarn_discovery.browse_products' | t }}</a></p></noscript>
</yarn-discovery-search>
{% schema %}
{
  "name": "作品与商品搜索",
  "settings": [
    { "type": "paragraph", "content": "搜索读取作品自己的名称、简介，以及商品自己的名称、描述和用途。示例关键词是编辑推荐，不显示为热门搜索或个人历史。" }
  ],
  "blocks": [
    { "type": "suggestion", "name": "示例关键词", "limit": 5, "settings": [ { "type": "text", "id": "query", "label": "关键词" } ] }
  ]
}
{% endschema %}
