{{ 'yarn-cards.css' | asset_url | stylesheet_tag }}
{{ 'yarn-discovery.css' | asset_url | stylesheet_tag }}
{{ 'yarn-filter-bar.css' | asset_url | stylesheet_tag }}
{{ 'yarn-search.css' | asset_url | stylesheet_tag }}
{{ 'yarn-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yarn-search.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  #149 搜索结果按「毛线 / 材料包 / 手工成品」分组，并在结果上方接入与 Collection 页一致的 6 维度单行胶囊筛选条与胶囊排序。
  毛线 = 毛线集合（默认 yarn）的商品，卡片与目录同一张 yarn-pick-card（clean_title: true）；材料包 = 通过 yarn-kit-visible 的 yarn_project；
  手工成品 = 成品集合（默认 finished-goods）。成品集合为空时标签显示「准备中」并禁用。
{%- endcomment -%}
{%- liquid
  assign yarn_collection = collections[section.settings.yarn_collection]
  assign finished_collection = collections[section.settings.finished_collection]
  assign finished_coming_soon = true
  if finished_collection != blank and finished_collection.products_count > 0
    assign finished_coming_soon = false
  endif
  assign kits_url = section.settings.kits_url | default: routes.all_products_collection_url
  assign search_beginner_handles = '' | split: ','
  if collections['beginner-picks'] != blank
    assign search_beginner_handles = collections['beginner-picks'].products | map: 'handle'
  endif
  assign search_yarn_grid = ''
  assign search_yarn_next = ''
  assign search_categories = ''
  assign search_filter_uid = 'SearchFilter-' | append: section.id
  assign sort_rel_label = 'yarn_collection.sort_relevance' | t
  assign sort_pa_label = 'yarn_collection.sort_price_ascending' | t
  assign sort_pd_label = 'yarn_collection.sort_price_descending' | t
  assign sort_new_label = 'yarn_collection.sort_created_descending' | t
-%}
{%- if yarn_collection != blank -%}
  {%- paginate yarn_collection.products by 250 -%}
    {%- capture search_yarn_tokens -%}
      {%- for category_product in yarn_collection.products -%}
        {%- render 'yarn-facets', product: category_product, beginner_handles: search_beginner_handles -%}
        {{- '|' -}}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign search_token_rows = search_yarn_tokens | split: '|' -%}
    {%- capture search_categories -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'category' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign category_filter = block.settings.filter | split: ':'
          assign category_group = category_filter[0]
          assign category_value = category_filter[1]
          assign category_token = ' ' | append: block.settings.filter | append: ' '
          if category_group == 'beginner'
            assign category_query = 'ycb_beginner=1'
            assign category_key = 'yarn_collection.beginner'
          else
            assign category_query = 'ycb_' | append: category_group | append: '=' | append: category_value
            assign category_key = 'yarn_collection.facet_' | append: category_group | append: '_' | append: category_value
          endif
          if block.settings.filter == 'grams:big'
            assign category_key = 'yarn_collection.nav_big'
          endif
          assign category_name = category_key | t
          assign category_count = 0
          assign category_image = block.settings.image
          for category_row in search_token_rows
            if category_row contains category_token
              assign category_count = category_count | plus: 1
              if category_image == blank
                assign category_product = yarn_collection.products[forloop.index0]
                assign category_image = category_product.metafields.yarn.card_image.value | default: category_product.featured_image
              endif
            endif
          endfor
          if category_count == 0
            continue
          endif
        -%}
        <li>
          <a class="yd-search__chip" href="{{ yarn_collection.url }}?{{ category_query }}" data-search-category data-category-name="{{ category_name | escape }}" data-category-aliases="{{ block.settings.aliases | escape }}" {{ block.shopify_attributes }}>
            <span class="yd-search__chip-photo">{%- if category_image != blank -%}{{ category_image | image_url: width: 120 | image_tag: widths: '80, 120', sizes: '40px', loading: 'lazy', alt: '' }}{%- endif -%}</span>
            <span class="yd-search__chip-name">{{ category_name | escape }}</span>
            <span class="yd-search__chip-count">{{ category_count }}</span>
          </a>
        </li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture search_yarn_grid -%}
      <div class="yd-search__grid" data-search-catalog="yarn">
        {%- for search_product in yarn_collection.products -%}
          {%- assign search_is_beginner = false -%}
          {%- if search_beginner_handles contains search_product.handle -%}{%- assign search_is_beginner = true -%}{%- endif -%}
          {%- render 'yarn-search-product', search_product: search_product, group: 'yarn', is_beginner: search_is_beginner, beginner_handles: search_beginner_handles -%}
        {%- endfor -%}
      </div>
    {%- endcapture -%}
    {%- capture search_yarn_next -%}
      {%- if paginate.next -%}<a data-search-next="yarn" href="{{ paginate.next.url | escape }}&amp;section_id={{ section.id | url_encode }}" hidden>{{ 'yarn_project.more' | t }}</a>{%- endif -%}
    {%- endcapture -%}
  {%- endpaginate -%}
{%- endif -%}
<yarn-discovery-search class="yd-search" data-search-url="{{ routes.search_url }}" data-section-id="{{ section.id }}"
  data-group-thick="{{ 'yarn_collection.facet_group_thick' | t | escape }}"
  data-group-color="{{ 'yarn_collection.facet_group_color' | t | escape }}"
  data-group-fiber="{{ 'yarn_collection.facet_group_fiber' | t | escape }}"
  data-group-works="{{ 'yarn_collection.nav_works' | t | escape }}"
  data-group-grams="{{ 'yarn_collection.facet_group_grams' | t | escape }}"
  data-group-feature="{{ 'yarn_collection.facet_group_feature' | t | escape }}"
  data-label-stock="{{ 'yarn_collection.in_stock_only' | t | escape }}"
  data-label-price="{{ 'yarn_collection.price' | t | escape }}">
  <nav class="yarn-account-header" aria-label="{{ 'yarn_discovery.account_navigation' | t }}">
    <a class="yd-search__back" href="{{ routes.root_url }}" aria-label="{{ 'yarn_discovery.back' | t }}">{{ 'icon-arrow.svg' | inline_asset_content }}</a>
    <a class="yarn-account-header__logo" href="{{ routes.root_url }}">{% render 'yarn-wordmark' %}</a>
    <a class="yarn-account-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">{{ 'icon-cart-empty.svg' | inline_asset_content }}</a>
  </nav>
  <div class="yarn-account-intro">
    <header class="yd-search__bar">
      <a class="yd-search__back" href="{{ routes.root_url }}" data-search-back aria-label="{{ 'yarn_discovery.back' | t }}">{{ 'icon-arrow.svg' | inline_asset_content }}</a>
      <h1 data-search-title data-title="{{ 'yarn_discovery.search' | t }}" data-favorites-title="{{ 'yarn_discovery.my_favorites' | t }}">{{ 'yarn_discovery.search' | t }}</h1>
      <a class="yd-search__favorites" href="{{ routes.search_url }}?browse=favorites" data-favorites-link>{{ 'yarn_discovery.favorites' | t }}</a>
    </header>
    <form class="yd-search__form" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
      <div class="yd-search__field">
        <button class="yd-search__icon" type="submit" aria-label="{{ 'yarn_discovery.search' | t }}">{{ 'icon-search.svg' | inline_asset_content }}</button>
        <div>
          <label class="visually-hidden" for="DiscoveryQuery-{{ section.id }}">{{ 'yarn_discovery.search_placeholder' | t }}</label>
          <input id="DiscoveryQuery-{{ section.id }}" name="q" type="search" value="{{ search.terms | escape }}" placeholder="{{ 'yarn_discovery.search_placeholder' | t }}" autocomplete="off">
          <p>{{ 'yarn_discovery.search_scope' | t }}</p>
        </div>
        <button class="yd-search__icon yd-search__clear" type="button" data-search-clear aria-label="{{ 'yarn_discovery.clear_search' | t }}" {% if search.terms == blank %}hidden{% endif %}><span>{{ 'icon-close.svg' | inline_asset_content }}</span></button>
      </div>
    </form>
    <aside class="yd-search__local-note" data-favorites-local-note hidden>
      <strong>{{ 'yarn_discovery.local_favorites_title' | t }}</strong>
      <p>{{ 'yarn_discovery.favorites_local_note' | t }}</p>
    </aside>
  </div>
  <div class="yarn-account-content">
    <nav class="yd-search__tabs" aria-label="{{ 'yarn_discovery.groups_label' | t }}">
      <button class="yd-search__tab" type="button" data-search-tab="" aria-pressed="true">{{ 'yarn_discovery.group_all' | t }} <span data-search-tab-count></span></button>
      <button class="yd-search__tab" type="button" data-search-tab="yarn" aria-pressed="false">{{ 'yarn_discovery.group_yarn' | t }} <span data-search-tab-count></span></button>
      <button class="yd-search__tab" type="button" data-search-tab="kit" aria-pressed="false">{{ 'yarn_discovery.group_kit' | t }} <span data-search-tab-count></span></button>
      <button class="yd-search__tab" type="button" data-search-tab="finished" aria-pressed="false"{% if finished_coming_soon %} disabled{% endif %}>{{ 'yarn_discovery.group_finished' | t }} {% if finished_coming_soon %}<span class="yd-search__soon">{{ 'yarn_discovery.coming_soon' | t }}</span>{% else %}<span data-search-tab-count></span>{% endif %}</button>
    </nav>

  <div class="yd-search__toolbar yfb" data-search-toolbar hidden>
    <div class="yfb__bar">
      <div class="yfb__filters">
        {%- render 'yarn-filter-menus', uid: search_filter_uid -%}
      </div>
      <div class="yfb__meta">
        <p class="yfb__count" data-search-count aria-live="polite" data-template="{{ 'yarn_discovery.result_line' | t: count: '[count]', query: '[query]' | escape }}" data-short-template="{{ 'yarn_collection.count_all' | t: n: '[count]' | escape }}" hidden></p>
        <details class="yfb__menu yfb__menu--sort" data-yfb-menu="sort">
          <summary class="yfb__trigger yfb__trigger--sort" aria-label="{{ 'yarn_collection.sort' | t }}">
            <span data-search-sort-label data-t="{{ 'yarn_collection.sort_option' | t: name: '__N__' | escape }}">{{ 'yarn_collection.sort_option' | t: name: sort_rel_label }}</span>
            <svg class="yfb__chev" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="yfb__popover">
            <div class="yfb__pop-list">
              <button class="yfb__opt" type="button" data-search-sort-opt="" data-sort-name="{{ sort_rel_label | escape }}" aria-pressed="true">
                <span class="yfb__opt-left">
                  <span class="yfb__check yfb__check--radio" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L5 8.7L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="yfb__opt-name">{{ sort_rel_label }}</span>
                </span>
              </button>
              <button class="yfb__opt" type="button" data-search-sort-opt="price-ascending" data-sort-name="{{ sort_pa_label | escape }}" aria-pressed="false">
                <span class="yfb__opt-left">
                  <span class="yfb__check yfb__check--radio" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L5 8.7L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="yfb__opt-name">{{ sort_pa_label }}</span>
                </span>
              </button>
              <button class="yfb__opt" type="button" data-search-sort-opt="price-descending" data-sort-name="{{ sort_pd_label | escape }}" aria-pressed="false">
                <span class="yfb__opt-left">
                  <span class="yfb__check yfb__check--radio" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L5 8.7L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="yfb__opt-name">{{ sort_pd_label }}</span>
                </span>
              </button>
              <button class="yfb__opt" type="button" data-search-sort-opt="created-descending" data-sort-name="{{ sort_new_label | escape }}" aria-pressed="false">
                <span class="yfb__opt-left">
                  <span class="yfb__check yfb__check--radio" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L5 8.7L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="yfb__opt-name">{{ sort_new_label }}</span>
                </span>
              </button>
            </div>
          </div>
        </details>
      </div>
    </div>
    <div class="yfb__active" data-search-active hidden>
      <div class="yfb__filters" data-search-active-tags></div>
      <button class="yfb__clear" type="button" data-search-clear-filters>{{ 'yarn_collection.clear_all' | t }}</button>
    </div>
  </div>

  <p class="yd-search__status" data-search-loading role="status" hidden>{{ 'yarn_project.loading' | t }}</p>
  <section class="yd-search__error" data-search-error hidden role="alert">
    <h2>{{ 'yarn_discovery.load_error' | t }}</h2>
    <p>{{ 'yarn_discovery.load_error_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-search-retry>{{ 'yarn_project.retry' | t }}</button>
  </section>
  <section class="yd-search__empty" data-search-empty hidden>
    <h2 data-search-empty-title data-title="{{ 'yarn_discovery.empty' | t }}" data-query-template="{{ 'yarn_discovery.empty_query' | t: query: '[query]' | escape }}">{{ 'yarn_discovery.empty' | t }}</h2>
    <p>{{ 'yarn_discovery.empty_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-search-empty-clear hidden>{{ 'yarn_collection.clear_all' | t }}</button>
  </section>
  <section class="yd-search__empty" data-favorites-empty hidden>
    <img class="yarn-account-empty-cat" src="{{ 'hitoami-cat-basket.webp' | asset_url }}" width="320" height="306" alt="" loading="lazy">
    <h2>{{ 'yarn_discovery.favorites_empty' | t }}</h2>
    <p>{{ 'yarn_discovery.favorites_empty_hint' | t }}</p>
    <a class="yd-search__action" href="{{ yarn_collection.url | default: routes.all_products_collection_url }}">{{ 'yarn_discovery.browse_yarn' | t }}</a>
  </section>
  <section class="yd-search__empty" data-favorites-login hidden>
    <h2>{{ 'yarn_discovery.login_title' | t }}</h2>
    <p>{{ 'yarn_discovery.login_hint' | t }}</p>
    <button class="yd-search__action" type="button" data-favorites-login-button>{{ 'customer.log_in' | t }}</button>
  </section>
  <section class="yd-search__empty" data-favorites-unavailable hidden>
    <h2>{{ 'yarn_discovery.favorites' | t }}</h2>
    <p>{{ 'yarn_discovery.favorites_unavailable' | t }}</p>
    <a class="yd-search__action" href="{{ yarn_collection.url | default: routes.all_products_collection_url }}">{{ 'yarn_discovery.browse_yarn' | t }}</a>
  </section>
  <div class="yd-search__browse" data-search-browse>
    <section class="yd-search__examples-block">
      <h2>{{ 'yarn_discovery.try_searching' | t }}</h2>
      <div class="yd-search__examples">
        {% assign example_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'suggestion' and block.settings.query != blank %}
            <a href="{{ routes.search_url }}?q={{ block.settings.query | url_encode }}" data-search-suggestion="{{ block.settings.query | escape }}" {{ block.shopify_attributes }}>{{ block.settings.query | escape }}</a>
            {% assign example_count = example_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if example_count == 0 %}
          {% for index in (1..4) %}
            {% assign example_key = 'yarn_discovery.example_' | append: index %}
            {% assign example_query = example_key | t %}
            <a href="{{ routes.search_url }}?q={{ example_query | url_encode }}" data-search-suggestion="{{ example_query | escape }}">{{ example_query }}</a>
          {% endfor %}
        {% endif %}
      </div>
    </section>
    {%- if search_categories != blank -%}
      <section class="yd-search__categories">
        <h2>{{ 'yarn_discovery.browse_by_feel' | t }}</h2>
        <ul class="yd-search__chips" role="list">{{ search_categories }}</ul>
      </section>
    {%- endif -%}
  </div>
  <div data-search-results hidden>
    <section class="yd-search__group" data-search-group="yarn" aria-labelledby="SearchYarn-{{ section.id }}">
      <div class="yd-search__group-head">
        <h2 id="SearchYarn-{{ section.id }}">{{ 'yarn_discovery.group_yarn' | t }} <span class="yd-search__group-count" data-search-group-count="yarn"></span></h2>
        <a class="yd-search__group-link" href="{{ yarn_collection.url }}" data-search-category-link data-template="{{ 'yarn_discovery.category_link' | t: name: '[name]' | escape }}" hidden></a>
      </div>
      {%- if yarn_collection != blank -%}
        {{ search_yarn_grid }}
        {{ search_yarn_next }}
      {%- endif -%}
      <button class="yd-search__more" type="button" data-search-show-all data-template="{{ 'yarn_discovery.show_all_yarn' | t: count: '[count]' | escape }}" hidden></button>
    </section>
    <section class="yd-search__group" data-search-group="kit" aria-labelledby="SearchKits-{{ section.id }}">
      <div class="yd-search__group-head">
        <h2 id="SearchKits-{{ section.id }}">{{ 'yarn_discovery.group_kit' | t }} <span class="yd-search__group-count" data-search-group-count="kit"></span></h2>
        <a class="yd-search__group-link" href="{{ kits_url }}">{{ 'yarn_discovery.all_kits' | t }}</a>
      </div>
      {% paginate shop.metaobjects.yarn_project.values by 250 %}
        <div class="yd-search__kits" data-search-catalog="kit">
          {%- for project in shop.metaobjects.yarn_project.values -%}
            {%- capture kit_visible -%}{%- render 'yarn-kit-visible', project: project -%}{%- endcapture -%}
            {%- if kit_visible != 'true' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign kit_total_minor = 0
              assign kit_avail_count = 0
              assign kit_kind_count = 0
              assign kit_prices_ok = true
              for kit_comp in project.components.value
                if kit_comp.component_type.value == '毛线' and kit_comp.variant.value != blank
                  assign kv = kit_comp.variant.value
                  assign kq = kit_comp.quantity.value | default: 1
                  assign kit_kind_count = kit_kind_count | plus: 1
                  if kv.price <= 0
                    assign kit_prices_ok = false
                  elsif kv.available
                    assign kit_avail_count = kit_avail_count | plus: 1
                  endif
                  assign kline = kv.price | times: kq
                  assign kit_total_minor = kit_total_minor | plus: kline
                endif
              endfor
              assign kit_is_avail = true
              if kit_kind_count > 0 and kit_avail_count == 0
                assign kit_is_avail = false
              endif
              unless kit_prices_ok
                assign kit_total_minor = 0
              endunless
            -%}
            <div class="yd-search__item" data-discovery-card data-entity-type="project" data-entity-id="{{ project.system.id }}" data-group="kit"
              data-title="{{ project.title.value | escape }}" data-summary="{{ project.summary.value | escape }}" data-tags=""
              data-facets="" data-price="{{ kit_total_minor | divided_by: 100.0 }}" data-available="{{ kit_is_avail }}" data-created="0">
              {%- render 'yarn-project-pick-card', project: project -%}
              {%- render 'yarn-favorite-button', entity_type: 'project', entity_id: project.system.id, entity_title: project.title.value -%}
            </div>
          {%- endfor -%}
        </div>
        {% if paginate.next %}<a data-search-next="kit" href="{{ paginate.next.url | escape }}&amp;section_id={{ section.id | url_encode }}" hidden>{{ 'yarn_project.more' | t }}</a>{% endif %}
      {% endpaginate %}
    </section>
    {%- unless finished_coming_soon -%}
      <section class="yd-search__group" data-search-group="finished" aria-labelledby="SearchFinished-{{ section.id }}">
        <div class="yd-search__group-head">
          <h2 id="SearchFinished-{{ section.id }}">{{ 'yarn_discovery.group_finished' | t }} <span class="yd-search__group-count" data-search-group-count="finished"></span></h2>
          <a class="yd-search__group-link" href="{{ finished_collection.url }}">{{ 'yarn_discovery.all_finished' | t }}</a>
        </div>
        {% paginate finished_collection.products by 250 %}
          <div class="yd-search__grid" data-search-catalog="finished">
            {%- for search_product in finished_collection.products -%}
              {%- render 'yarn-search-product', search_product: search_product, group: 'finished', beginner_handles: search_beginner_handles -%}
            {%- endfor -%}
          </div>
          {% if paginate.next %}<a data-search-next="finished" href="{{ paginate.next.url | escape }}&amp;section_id={{ section.id | url_encode }}" hidden>{{ 'yarn_project.more' | t }}</a>{% endif %}
        {% endpaginate %}
      </section>
    {%- endunless -%}
    {%- if finished_coming_soon -%}
      <p class="yd-search__note" data-search-finished-note hidden>{{ 'yarn_discovery.finished_coming_soon' | t }}</p>
    {%- endif -%}
  </div>
  </div>
  <footer class="yarn-account-help">
    <span>{{ 'yarn_discovery.account_help' | t }}</span>
    {%- if settings.yarn_line_url != blank -%}
      <a href="{{ settings.yarn_line_url | escape }}">{{ 'yarn_discovery.account_line_help' | t }}</a>
    {%- else -%}
      <a href="{{ pages.contact.url | default: routes.root_url }}">{{ 'yarn_discovery.account_contact' | t }}</a>
    {%- endif -%}
  </footer>
  <noscript><p>{{ 'yarn_discovery.javascript_required' | t }} <a href="{{ yarn_collection.url | default: routes.all_products_collection_url }}">{{ 'yarn_discovery.browse_yarn' | t }}</a></p></noscript>
</yarn-discovery-search>
{% schema %}
{
  "name": "搜索：毛线 / 材料包 / 成品",
  "settings": [
    { "type": "paragraph", "content": "搜索读取毛线和成品自己的名称、描述、标签与分类名，以及材料包的名称和简介。示例关键词是编辑推荐，不显示为热门搜索或个人历史。" },
    { "type": "collection", "id": "yarn_collection", "label": "毛线集合" },
    { "type": "collection", "id": "finished_collection", "label": "手工成品集合", "info": "集合为空时，「手工成品」标签显示「准备中」。" },
    { "type": "url", "id": "kits_url", "label": "「全部材料包」链接" }
  ],
  "blocks": [
    { "type": "suggestion", "name": "示例关键词", "limit": 6, "settings": [ { "type": "text", "id": "query", "label": "关键词" } ] },
    {
      "type": "category",
      "name": "毛线分类",
      "limit": 8,
      "settings": [
