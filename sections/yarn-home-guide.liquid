{%- capture heading -%}{% render 'yarn-setting-text', settings: section.settings, key: 'heading' %}{%- endcapture -%}
<section class="yarn-home-guide yarn-home-guide--{{ section.settings.mode }} page-width" aria-labelledby="Guide-{{ section.id }}">
 <h2 id="Guide-{{ section.id }}">{{ heading | escape }}</h2>
 {% if section.settings.mode == 'steps' %}<ol>{% endif %}
 {% for block in section.blocks %}
  {%- capture title -%}{% render 'yarn-setting-text', settings: block.settings, key: 'title' %}{%- endcapture -%}
  {%- capture text -%}{% render 'yarn-setting-text', settings: block.settings, key: 'text' %}{%- endcapture -%}
  {% if section.settings.mode == 'faq' %}
   <details {{ block.shopify_attributes }}><summary>{{ title | escape }}</summary><p>{{ text | escape }}</p></details>
  {% else %}
   <li {{ block.shopify_attributes }}><h3>{{ title | escape }}</h3><p>{{ text | escape }}</p></li>
  {% endif %}
 {% endfor %}
 {% if section.settings.mode == 'steps' %}</ol>{% endif %}
</section>
{% schema %}
{
 "name":"新手指引与常见问题",
 "settings":[
  {"type":"select","id":"mode","label":"形式","options":[{"value":"steps","label":"步骤"},{"value":"faq","label":"常见问题"}],"default":"steps"},
  {"type":"text","id":"heading","label":"日文 · 标题","default":"はじめての方へ"},
  {"type":"text","id":"heading_zh","label":"中文 · 标题","default":"第一次来，从这里开始"},
  {"type":"text","id":"heading_en","label":"英文 · 标题","default":"New here? Start here."}
 ],
 "blocks":[{"type":"item","name":"一项","settings":[
  {"type":"text","id":"title","label":"日文 · 问题或步骤"},{"type":"text","id":"title_zh","label":"中文 · 问题或步骤"},{"type":"text","id":"title_en","label":"英文 · 问题或步骤"},
  {"type":"textarea","id":"text","label":"日文 · 说明"},{"type":"textarea","id":"text_zh","label":"中文 · 说明"},{"type":"textarea","id":"text_en","label":"英文 · 说明"}
 ]}],"presets":[{"name":"新手指引与常见问题"}]
}
{% endschema %}
