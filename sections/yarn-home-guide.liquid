{% comment %}
  首页新手指引（步骤）与常见问题（#131；#140 按 Claude Design「首页 v2」）。
  左侧：小标题、标题、说明；常见问题另有 LINE 求助卡（未填 LINE 链接时链到联系页并改用备用按钮文字）。
  右侧：步骤卡或问答（首条默认展开），问答末尾可加「查看全部问题」链接。三语文案经 yarn-setting-text 取。
{% endcomment %}
{%- capture heading -%}{% render 'yarn-setting-text', settings: section.settings, key: 'heading' %}{%- endcapture -%}
{%- capture eyebrow -%}{% render 'yarn-setting-text', settings: section.settings, key: 'eyebrow' %}{%- endcapture -%}
{%- capture note -%}{% render 'yarn-setting-text', settings: section.settings, key: 'note' %}{%- endcapture -%}
{%- capture help_title -%}{% render 'yarn-setting-text', settings: section.settings, key: 'help_title' %}{%- endcapture -%}
{%- capture help_text -%}{% render 'yarn-setting-text', settings: section.settings, key: 'help_text' %}{%- endcapture -%}
{%- capture help_cta -%}{% render 'yarn-setting-text', settings: section.settings, key: 'help_cta' %}{%- endcapture -%}
{%- capture all_label -%}{% render 'yarn-setting-text', settings: section.settings, key: 'all_label' %}{%- endcapture -%}
<section class="yarn-home-guide yarn-home-guide--{{ section.settings.mode }} page-width" aria-labelledby="Guide-{{ section.id }}">
 <div class="yarn-home-guide__intro">
  {%- if eyebrow != blank -%}<p class="yarn-home-guide__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
  <h2 id="Guide-{{ section.id }}">{{ heading | escape }}</h2>
  {%- if note != blank -%}<p class="yarn-home-guide__note">{{ note | escape }}</p>{%- endif -%}
  {%- if section.settings.mode == 'faq' and help_cta != blank -%}
   {%- capture help_href -%}{%- if section.settings.help_link != blank -%}{{ section.settings.help_link }}{%- else -%}{% render 'yarn-local-url', url: pages.contact.url %}{%- endif -%}{%- endcapture -%}
   {%- if section.settings.help_link == blank -%}{%- capture help_cta -%}{% render 'yarn-setting-text', settings: section.settings, key: 'help_fallback' %}{%- endcapture -%}{%- endif -%}
   <div class="yarn-home-guide__help">
    {%- if help_title != blank -%}<p class="yarn-home-guide__help-title">{{ help_title | escape }}</p>{%- endif -%}
    {%- if help_text != blank -%}<p class="yarn-home-guide__help-text">{{ help_text | escape }}</p>{%- endif -%}
    <a class="yarn-home-guide__help-cta" href="{{ help_href }}"{% if section.settings.help_link != blank %} target="_blank" rel="noopener"{% endif %}>{{ help_cta | escape }}</a>
   </div>
  {%- endif -%}
 </div>
 {% if section.settings.mode == 'steps' %}<ol class="yarn-home-guide__list">{% else %}<div class="yarn-home-guide__list">{% endif %}
 {% for block in section.blocks %}
  {%- capture title -%}{% render 'yarn-setting-text', settings: block.settings, key: 'title' %}{%- endcapture -%}
  {%- capture text -%}{% render 'yarn-setting-text', settings: block.settings, key: 'text' %}{%- endcapture -%}
  {% if section.settings.mode == 'faq' %}
   <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}><summary><span class="yarn-home-guide__q" aria-hidden="true">Q</span><span class="yarn-home-guide__question">{{ title | escape }}</span></summary><p>{{ text | escape }}</p></details>
  {% else %}
   <li {{ block.shopify_attributes }}><h3>{{ title | escape }}</h3><p>{{ text | escape }}</p></li>
  {% endif %}
 {% endfor %}
 {% if section.settings.mode == 'steps' %}</ol>{% else %}
  {%- if section.settings.all_link != blank and all_label != blank -%}<a class="yarn-home-guide__all" href="{% render 'yarn-local-url', url: section.settings.all_link %}">{{ all_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
 </div>{% endif %}
</section>
{% schema %}
{
 "name":"新手指引与常见问题",
 "settings":[
  {"type":"select","id":"mode","label":"形式","options":[{"value":"steps","label":"步骤"},{"value":"faq","label":"常见问题"}],"default":"steps"},
  {"type":"text","id":"eyebrow","label":"日文 · 小标题（可空）"},
  {"type":"text","id":"eyebrow_zh","label":"中文 · 小标题（可空）"},
  {"type":"text","id":"eyebrow_en","label":"英文 · 小标题（可空）"},
  {"type":"text","id":"heading","label":"日文 · 标题","default":"はじめての方へ"},
  {"type":"text","id":"heading_zh","label":"中文 · 标题","default":"第一次来，从这里开始"},
  {"type":"text","id":"heading_en","label":"英文 · 标题","default":"New here? Start here."},
  {"type":"text","id":"note","label":"日文 · 说明（可空）"},
  {"type":"text","id":"note_zh","label":"中文 · 说明（可空）"},
  {"type":"text","id":"note_en","label":"英文 · 说明（可空）"},
  {"type":"header","content":"常见问题"},
  {"type":"checkbox","id":"open_first","label":"默认展开第一条","default":true},
  {"type":"text","id":"help_title","label":"日文 · 求助卡标题"},
  {"type":"text","id":"help_title_zh","label":"中文 · 求助卡标题"},
  {"type":"text","id":"help_title_en","label":"英文 · 求助卡标题"},
  {"type":"text","id":"help_text","label":"日文 · 求助卡说明"},
  {"type":"text","id":"help_text_zh","label":"中文 · 求助卡说明"},
  {"type":"text","id":"help_text_en","label":"英文 · 求助卡说明"},
  {"type":"url","id":"help_link","label":"LINE 链接","info":"官方 LINE 加好友链接；留空时按钮链到联系页，并显示下面的备用按钮文字。"},
  {"type":"text","id":"help_cta","label":"日文 · 求助卡按钮","info":"留空时不显示求助卡。"},
  {"type":"text","id":"help_cta_zh","label":"中文 · 求助卡按钮"},
  {"type":"text","id":"help_cta_en","label":"英文 · 求助卡按钮"},
  {"type":"text","id":"help_fallback","label":"未配置 LINE · 日文按钮","default":"お問い合わせ"},
  {"type":"text","id":"help_fallback_zh","label":"未配置 LINE · 中文按钮","default":"联系我们"},
  {"type":"text","id":"help_fallback_en","label":"未配置 LINE · 英文按钮","default":"Contact us"},
  {"type":"url","id":"all_link","label":"查看全部问题链接（可空）"},
  {"type":"text","id":"all_label","label":"日文 · 查看全部文字","default":"すべての質問を見る"},
  {"type":"text","id":"all_label_zh","label":"中文 · 查看全部文字","default":"查看全部问题"},
  {"type":"text","id":"all_label_en","label":"英文 · 查看全部文字","default":"See all questions"}
 ],
 "blocks":[{"type":"item","name":"一项","settings":[
  {"type":"text","id":"title","label":"日文 · 问题或步骤"},{"type":"text","id":"title_zh","label":"中文 · 问题或步骤"},{"type":"text","id":"title_en","label":"英文 · 问题或步骤"},
  {"type":"textarea","id":"text","label":"日文 · 说明"},{"type":"textarea","id":"text_zh","label":"中文 · 说明"},{"type":"textarea","id":"text_en","label":"英文 · 说明"}
 ]}],"presets":[{"name":"新手指引与常见问题"}]
}
{% endschema %}
