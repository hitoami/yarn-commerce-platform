{%- comment -%}
  #243 毛线详情页「在手感地图上看」：打开毛线目录的手感地图并标出这团线（ycb_here）。
  #366 地图按 yarn-facets 的粗细档（yarn.ball_length_m / yarn.ball_weight_g）排；两项都有才显示入口，否则这团线不在图上。
  参数：product
{%- endcomment -%}
{%- liquid
  assign map_w = product.metafields.yarn.ball_weight_g.value | plus: 0
  assign map_len = product.metafields.yarn.ball_length_m.value | plus: 0
-%}
{%- if map_w > 0 and map_len > 0 and collections['yarn'] != blank -%}
  <a class="yp-map-link" href="{{ collections['yarn'].url }}?ycb_view=map&amp;ycb_here={{ product.handle | url_encode }}">
    {%- render 'yarn-weight-strand', band: 2 -%}
    <span>{{ 'yarn_collection.map_from_product' | t }}</span>
    <span aria-hidden="true">›</span>
  </a>
{%- endif -%}
