{%- comment -%}
  #355 导航下拉里一组筛选链接（桌面浮层与手机抽屉共用）：每项链到毛线目录并带 ycb_<组>=<值>；
  facets 是页头对毛线目录全部商品算出的 yarn-facets 标记，没有商品的项不输出，所以不会点到空结果。
  各组的选项与顺序只在这里定义（分类定稿 2026-11-19）；文案键 yarn_collection.facet_<组>_<值>。
  picks（推荐）是首页吊牌那一层的捷径：新手推荐（ycb_beginner=1）、毛茸茸、钩针用线（ycb_feature）、大团毛线（ycb_grams=big）。
  渐变段染、轻柔细线已在花色 / 粗细里，不重复。
  用法：{%- render 'yarn-nav-facet-links', group: 'thick', facets: nav_facets, base_url: url, link_class: '…', id_prefix: '…' -%}
{%- endcomment -%}
{%- liquid
  case group
    when 'thick'
      assign nfl_values = 'thick:fine,thick:medium,thick:chunky'
    when 'color'
      assign nfl_values = 'color:solid,color:variegated'
    when 'fiber'
      assign nfl_values = 'fiber:wool,fiber:wool_blend,fiber:cotton,fiber:synthetic'
    when 'works'
      assign nfl_values = 'works:sweater,works:hat,works:scarf,works:blanket,works:bag,works:doll'
    when 'picks'
      assign nfl_values = 'beginner:yes,feature:fluffy,feature:crochet,grams:big'
  endcase
  assign nfl_values = nfl_values | split: ','
-%}
{%- for nfl_pair in nfl_values -%}
  {%- assign nfl_token = ' ' | append: nfl_pair | append: ' ' -%}
  {%- unless facets contains nfl_token -%}{%- continue -%}{%- endunless -%}
  {%- assign nfl_parts = nfl_pair | split: ':' -%}
  {%- assign nfl_group = nfl_parts[0] -%}
  {%- assign nfl_value = nfl_parts[1] -%}
  {%- if nfl_group == 'beginner' -%}
    {%- assign nfl_query = 'ycb_beginner=1' -%}
    {%- assign nfl_key = 'yarn_collection.beginner' -%}
  {%- else -%}
    {%- assign nfl_query = 'ycb_' | append: nfl_group | append: '=' | append: nfl_value -%}
    {%- assign nfl_key = 'yarn_collection.facet_' | append: nfl_group | append: '_' | append: nfl_value -%}
  {%- endif -%}
  <li>
    <a id="{{ id_prefix }}-{{ nfl_group }}-{{ nfl_value }}" href="{{ base_url }}?{{ nfl_query }}" class="{{ link_class }}">{%- render 'yarn-facet-icon', group: nfl_group, value: nfl_value, uid: id_prefix -%}<span>{{ nfl_key | t }}</span></a>
  </li>
{%- endfor -%}
