{%- comment -%}
  Card meta row shared by homepage picks and collection cards: product kind on the left,
  real color count on the right (see yarn-card-color-count).
  Accepts: meta_product
{%- endcomment -%}
{%- capture yx_meta_kind %}{% render 'yarn-product-kind-label', kind_product: meta_product %}{% endcapture -%}
{%- capture yx_meta_colors %}{% render 'yarn-card-color-count', count_product: meta_product %}{% endcapture -%}
{%- assign yx_meta_kind = yx_meta_kind | strip -%}
{%- assign yx_meta_colors = yx_meta_colors | strip -%}
{%- if yx_meta_kind != blank or yx_meta_colors != blank -%}
  <span class="yx-card-meta">
    <span class="yx-card-meta__kind">{{ yx_meta_kind }}</span>
    {%- if yx_meta_colors != blank -%}<span class="yx-card-meta__colors">{{ yx_meta_colors }}</span>{%- endif -%}
  </span>
{%- endif -%}
