{%- capture product_kind -%}{%- render 'yarn-discovery-product-kind', product: product -%}{%- endcapture -%}
{%- capture product_kind_label -%}{%- render 'yarn-product-kind-label', kind_product: product -%}{%- endcapture -%}
{%- liquid
  assign product_kind_label = product_kind_label | strip
  assign product_summary = product.metafields.yarn.short_description.value
  if product_summary == blank
    assign product_summary = product.description | strip_html | strip | truncate: 90
  endif
  assign product_search_text = product.description | strip_html | append: ' ' | append: product.metafields.yarn.discovery_uses.value
-%}
<article class="yp-card yp-product-card" data-discovery-card data-entity-type="product" data-entity-id="{{ product.id }}"
  data-title="{{ product.title | escape }}" data-summary="{{ product_search_text | escape }}" data-tags="{{ product.tags | join: ' ' | escape }}"
  data-category="{{ product.metafields.yarn.discovery_categories.value | join: ',' | escape }}" data-purchase="{{ product_kind }}">
  <a class="yp-card__link" href="{{ product.url }}">
    <div class="yp-card__image{% if product.featured_image == blank %} yp-card__image--placeholder{% endif %}">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800, 1000', sizes: '(min-width: 990px) 310px, 46vw', alt: product.title }}
      {% endif %}
    </div>
    <div class="yp-card__body">
      <h3 class="yp-card__title">{{ product.title | escape }}</h3>
      {% if search_card and product_kind_label != blank %}<p class="yp-card__kind">{{ product_kind_label }}</p>{% elsif search_card and product_kind == 'finished' %}<p class="yp-card__kind">{{ 'yarn_discovery.kind_finished' | t }}</p>{% endif %}
      <p class="yp-card__summary">{{ product_summary | escape }}</p>
      <p class="yp-card__price">
        {% if product.price <= 0 %}{{ 'yarn_project.kit_not_on_sale' | t }}{% else %}{% if product.price_varies %}<span class="yp-card__price-from">{{ 'yarn_discovery.price_from' | t }}</span> {% endif %}
        {{ product.price | money }}{% endif %}
      </p>
    </div>
  </a>
  {%- comment -%}#161 与其他商品卡同一组按钮:放在链接之外,浮在卡片上层。{%- endcomment -%}
  {%- render 'yarn-favorite-button', entity_type: 'product', entity_id: product.id, entity_title: product.title, modifier: 'yx-card-fav' -%}
  {%- render 'yarn-card-cart', cart_product: product -%}
</article>
