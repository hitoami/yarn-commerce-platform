{%- comment -%}Desktop navigation. Menu labels and URLs come from Shopify Navigation; a top-level link to the collection with handle `sale` is highlighted.
  #355：指向毛线目录的那一项展开「粗细 / 花色 / 材质」三组，后面插入「织什么」；三组的顺序在这里，各组选项在 yarn-nav-facet-links，文案在 Theme locales。{%- endcomment -%}
{%- assign yarn_nav_groups = 'thick,color,fiber' | split: ',' -%}
<nav class="header__inline-menu" aria-label="{{ 'sections.header.menu' | t }}">
  <svg class="yarn-nav-strand-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <pattern id="YarnNavPly" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
      <rect width="3.2" height="3.2" style="fill: var(--yarn-home-logo)"/>
      <rect width="1.1" height="3.2" style="fill: var(--yarn-action-strong)"/>
    </pattern>
  </svg>
  <ul class="list-menu list-menu--inline yarn-main-menu" role="list">
    {%- for link in navigation_menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-YarnHeaderMenu-{{ forloop.index }}">
              <summary
                id="YarnHeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset{% if link.child_active %} header__active-menu-item{% endif %}"
              >
                <span>{{ link.title | escape }}{%- render 'yarn-nav-strand' -%}</span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="YarnHeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="YarnHeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url | escape }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}aria-current="page"{% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-YarnHeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary class="header__menu-item link link--text list-menu__item focus-inset caption-large">
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul class="header__submenu list-menu motion-reduce" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="YarnHeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url | escape }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}aria-current="page"{% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- elsif link.type == 'collection_link' and link.object.handle == section.settings.drawer_yarn_collection.handle and nav_facets != blank -%}
          {%- comment -%}#355 毛线：点击展开三组筛选（粗细 / 花色 / 材质），每项进毛线目录并带筛选；紧接着是「织什么」下拉。沿用 Rise 的 header-menu 开关与键盘行为。{%- endcomment -%}
          {%- capture mega_title -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'nav_yarn_title' -%}{%- endcapture -%}
          <header-menu>
            <details id="Details-YarnHeaderMenu-{{ forloop.index }}" class="mega-menu yarn-mega">
              <summary
                id="YarnHeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset{% if link.current or link.child_active %} header__active-menu-item{% endif %}"
              >
                <span>{{ link.title | escape }}{%- render 'yarn-nav-strand' -%}</span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div id="YarnMegaMenu-{{ forloop.index }}" class="mega-menu__content yarn-mega__content motion-reduce global-settings-popup" tabindex="-1">
                <div class="yarn-mega__inner">
                  <div class="yarn-mega__head">
                    <p class="yarn-mega__title">{{ mega_title | default: link.title | escape }}</p>
                    <div class="yarn-mega__links">
                      {%- if first_time != blank -%}<a class="yarn-mega__first" href="{{ link.url | escape }}?ycb_beginner=1">{{ 'yarn_collection.first_time' | t }}<span aria-hidden="true"> →</span></a>{%- endif -%}
                      <a class="yarn-mega__all" href="{{ link.url | escape }}">{{ 'yarn_project.entries_view_all' | t }}<span aria-hidden="true"> →</span></a>
                    </div>
                  </div>
                  <div class="yarn-mega__groups">
                    {%- for nav_group in yarn_nav_groups -%}
                      {%- capture nav_links -%}{%- render 'yarn-nav-facet-links', group: nav_group, facets: nav_facets, base_url: link.url, link_class: 'yarn-mega__link focus-inset', id_prefix: 'YarnHeaderMenu' -%}{%- endcapture -%}
                      {%- if nav_links == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign nav_group_key = 'yarn_collection.facet_group_' | append: nav_group -%}
                      <div class="yarn-mega__group">
                        <p class="yarn-mega__group-title" id="YarnMegaGroup-{{ nav_group }}">{{ nav_group_key | t }}</p>
                        <ul class="list-unstyled" role="list" aria-labelledby="YarnMegaGroup-{{ nav_group }}">{{ nav_links }}</ul>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </details>
          </header-menu>
          {%- capture works_links -%}{%- render 'yarn-nav-facet-links', group: 'works', facets: nav_facets, base_url: link.url, link_class: 'header__menu-item list-menu__item link link--text focus-inset caption-large', id_prefix: 'YarnHeaderMenu' -%}{%- endcapture -%}
        {%- else -%}
          <a
            id="YarnHeaderMenu-{{ link.handle }}"
            href="{{ link.url | escape }}"
            class="header__menu-item list-menu__item link link--text focus-inset{% if link.current %} header__active-menu-item{% endif %}{% if link.type == 'collection_link' and link.object.handle == 'sale' %} yarn-menu-sale{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span>{{ link.title | escape }}{%- render 'yarn-nav-strand' -%}</span>
            {%- if link.type == 'collection_link' and link.object.all_products_count == 0 -%}
              <span class="yarn-nav-badge">{{ 'sections.header.coming_soon' | t }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </li>
    {%- comment -%}#355：「织什么」紧跟在毛线后面；works_links 只在毛线那一项里算。{%- endcomment -%}
    {%- if works_links != blank -%}
      <li>
        <header-menu>
          <details id="Details-YarnHeaderMenu-works">
            <summary id="YarnHeaderMenu-works" class="header__menu-item list-menu__item link focus-inset">
              <span>{{ 'yarn_collection.nav_works' | t }}{%- render 'yarn-nav-strand' -%}</span>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </summary>
            <ul id="YarnHeaderMenu-MenuList-works" class="header__submenu list-menu list-menu--disclosure yarn-works-menu color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup" role="list" tabindex="-1">
              {{ works_links }}
            </ul>
          </details>
        </header-menu>
      </li>
      {%- assign works_links = blank -%}
    {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>
