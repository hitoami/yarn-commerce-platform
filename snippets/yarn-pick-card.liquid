{% comment %}
  商品卡(卡片家族):无框卡片,照片即卡片。图片优先读 metafield yarn.card_image(运营上传的场景图),无则用主图;
  信息行显示品类与真实颜色数;规格行读 metafield yarn.spec_line(可选,无则省略);
  原价只在 compare_at_price 真实存在时划线显示。整卡一个链接目标:标题链接铺满整卡,收藏与加入购物车按钮浮在其上(#153)。
  加入购物车按钮见 snippets/yarn-card-cart.liquid(单款式直接加入,多款式去详情页,售罄禁用)。
  show_discount:在图片左上角显示真实折扣比例(只在有划线价时)。
  beginner:由调用方按 beginner-picks 集合传入 true 时显示「新手友好」小徽章,正文仍显示正常规格行。
  layout: 'row'(#131 本季专题，用户 2026-10-16 选定 Figma 候选 E):同一张卡改为横排，图片在左，文字在右，并在价格下加「查看商品 →」;样式与数据不变。
  handmade(#131):手工成品。规格行换成「手工制作」说明;库存由 Shopify 跟踪且 10 件及以下时左上角显示「仅剩 N 件」,卖完显示「售罄」。
  card_line(分类页 2026-11-20):规格行下面加一句「卡片一句话」(商品字段 yarn.card_line,写手感、适合织什么);没填就不显示。
  clean_title(首页重排 2026-11-19):标题去掉开头【材质】与「｜」后的规格,材质放到规格行最前面;alt 仍用完整标题。
  eager(#189):首屏里的卡片（列表前几张）不懒加载，第一行加 fetchpriority=high，避免 LCP 图片迟迟不开始下载。
  其他商品(#177 R4):已定价但不可售时左上角显示「缺货」,价格降为灰色;未定价沿用「暂未开售」。没有标签 = 能买。
{% endcomment %}
{%- liquid
  assign card_image = card_product.metafields.yarn.card_image.value | default: card_product.featured_image
  assign card_off = 0
  if show_discount and card_product.compare_at_price > card_product.price
    assign card_off = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price
  endif
  assign card_name = card_product.title
  assign card_material = blank
  if clean_title
    if card_name contains '】'
      assign card_head = card_name | split: '】' | first
      if card_head contains '【'
        assign card_material = card_head | split: '【' | last | strip
        assign card_name = card_name | remove_first: card_head | remove_first: '】'
      endif
    endif
    assign card_name = card_name | split: '｜' | first | split: '|' | first | strip
    if card_name == blank
      assign card_name = card_product.title
    endif
  endif
  assign card_sizes = '(min-width: 750px) 300px, 45vw'
  if layout == 'row'
    assign card_sizes = '140px'
  endif
  assign card_stock = blank
  if handmade
    if card_product.available == false
      assign card_stock = 'yarn_project.card_sold_out' | t
    else
      assign card_left = 0
      assign card_tracked = false
      for card_variant in card_product.variants
        if card_variant.inventory_management == 'shopify'
          assign card_tracked = true
          if card_variant.inventory_quantity > 0
            assign card_left = card_left | plus: card_variant.inventory_quantity
          endif
        endif
      endfor
      if card_tracked and card_left > 0 and card_left <= 10
        assign card_stock = 'yarn_project.card_stock_left' | t: count: card_left
      endif
    endif
  elsif card_product.available == false and card_product.price > 0
    assign card_stock = 'yarn_project.kit_sold_out' | t
  endif
-%}
<div class="yx-product-card{% if layout == 'row' %} yx-product-card--row{% endif %}">
  <div class="yx-product-card__media">
    {%- if card_image != blank -%}
      {%- if eager -%}
        {{ card_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: card_sizes, loading: 'eager', fetchpriority: 'high', alt: card_image.alt | default: card_product.title }}
      {%- else -%}
        {{ card_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: card_sizes, loading: 'lazy', alt: card_image.alt | default: card_product.title }}
      {%- endif -%}
    {%- endif -%}
    {%- assign card_undyed = false -%}
    {%- if card_product.metafields.yarn.undyed.value == true -%}{%- assign card_undyed = true -%}{%- endif -%}
    {%- if card_off > 0 or card_stock != blank or beginner or card_undyed -%}
      <div class="yx-product-card__media-badges">
        {%- if card_off > 0 -%}<span class="yx-product-card__off">-{{ card_off }}%</span>{%- endif -%}
        {%- if card_stock != blank -%}<span class="yx-product-card__stock{% if card_product.available == false %} yx-product-card__stock--out{% endif %}">{{ card_stock }}</span>{%- endif -%}
        {%- if beginner -%}<span class="yx-product-card__badge">{{ 'yarn_project.card_badge_beginner' | t }}</span>{%- endif -%}
        {%- if card_undyed -%}<span class="yx-product-card__badge yx-product-card__badge--undyed">{{ 'yarn_project.card_badge_undyed' | t }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- render 'yarn-favorite-button', entity_type: 'product', entity_id: card_product.id, entity_title: card_product.title, modifier: 'yx-card-fav' -%}
  </div>
  <div class="yx-product-card__body">
    <div class="yx-product-card__head">
      <a class="yx-product-card__title yx-product-card__link" href="{{ card_product.url }}">{{ card_name | escape }}</a>
      <span class="yx-product-card__price{% if card_product.available == false or card_product.price <= 0 %} yx-product-card__price--muted{% endif %}">
        {%- if card_product.price <= 0 -%}{{ 'yarn_project.kit_not_on_sale' | t }}{%- else -%}{{ card_product.price | money }}{%- endif -%}
      </span>
    </div>
    <div class="yx-product-card__sub">
      {%- if handmade -%}
        <span class="yx-product-card__spec">{{ 'yarn_project.card_handmade_note' | t }}</span>
      {%- else -%}
        {%- capture card_colors %}{% render 'yarn-card-color-count', count_product: card_product %}{% endcapture -%}
        {%- assign card_colors = card_colors | strip -%}
        <span class="yx-product-card__spec">{% if card_material != blank %}{{ card_material | escape }} · {% endif %}{% render 'yarn-card-spec', product: card_product %}</span>
      {%- endif -%}
      {%- if card_product.price > 0 and card_product.compare_at_price > card_product.price -%}
        <s class="yx-product-card__was">{{ card_product.compare_at_price | money }}</s>
      {%- elsif handmade != true and card_colors != blank -%}
        <span class="yx-product-card__colors">{{ card_colors }}</span>
      {%- endif -%}
    </div>
    {%- if card_line and card_product.metafields.yarn.card_line.value != blank -%}
      <span class="yx-product-card__line">{{ card_product.metafields.yarn.card_line.value | escape }}</span>
    {%- endif -%}
    {%- capture card_cart_html -%}{%- render 'yarn-card-cart', cart_product: card_product -%}{%- endcapture -%}
    {%- if card_cart_html != blank -%}
      <div class="yx-product-card__buy">{{ card_cart_html }}</div>
    {%- endif -%}
    {%- render 'yarn-card-buy', buy_product: card_product -%}
    {%- if layout == 'row' -%}<span class="yx-product-card__more">{{ 'yarn_project.season_view_yarn' | t }} <span aria-hidden="true">→</span></span>{%- endif -%}
  </div>
</div>
