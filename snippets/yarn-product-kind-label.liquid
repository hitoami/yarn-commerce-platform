{%- comment -%}
  品类文案的唯一来源:经 yarn-product-kind（读 product.type / 集合）取主题 locale 文案。
  无匹配品类时返回空,由调用方决定是否降级。
{%- endcomment -%}
{%- capture kind_key -%}{%- render 'yarn-product-kind', product: kind_product -%}{%- endcapture -%}
{%- liquid
  assign kind_key = kind_key | strip
  case kind_key
    when 'yarn'
      echo 'yarn_project.card_badge_yarn' | t
    when 'kit'
      echo 'yarn_project.card_badge_kit' | t
    when 'finished'
      echo 'yarn_project.card_badge_finished' | t
    when 'tools'
      echo 'yarn_project.card_badge_tools' | t
  endcase
-%}
