sh" cx="3.9" cy="8.8" r="1.7"/><circle class="f-blush" cx="5.7" cy="6.2" r="1.7"/><circle class="f-blush" cx="8.3" cy="4.4" r="1.7"/><circle class="f-blush" cx="11.4" cy="3.8" r="1.7"/><circle class="f-blush" cx="14.6" cy="4.4" r="1.7"/><circle class="f-blush" cx="17.2" cy="6.2" r="1.7"/><circle class="f-blush" cx="19.0" cy="8.8" r="1.7"/><circle class="f-blush" cx="11.5" cy="12" r="8.2"/><path class="s-ink" d="M5.2 8.8 C 8.8 6.2, 14.2 6.2, 17.8 9 M3.8 12.8 C 8.2 10, 14.8 10, 19.2 13 M5.2 16.6 C 9 14.2, 14 14.2, 17.8 16.8" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".5"/>
