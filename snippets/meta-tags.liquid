{%- liquid
  assign og_site_name = 'hitoami'
  assign og_lang_raw = request.locale.iso_code | default: 'ja' | downcase
  assign og_is_zh = false
  assign og_is_en = false
  assign og_locale = 'ja_JP'
  assign og_default_title = 'hitoami｜毛糸と手編みの専門店'
  assign og_default_description = 'ひと玉ずつ、選ぶ楽しみ。グラデーションや段染め、モヘヤ、ループヤーンなどの毛糸と、作品ごとの編みキットをお届けするオンラインの毛糸屋さんです。'
  assign og_default_image_alt = 'hitoami｜窓辺の椅子に置かれた編みかけのニットと毛糸玉'

  if og_lang_raw == 'zh-cn' or og_lang_raw == 'zh' or og_lang_raw == 'zh-tw'
    assign og_is_zh = true
    assign og_locale = 'zh_CN'
    if og_lang_raw == 'zh-tw'
      assign og_locale = 'zh_TW'
    endif
    assign og_default_title = 'hitoami｜毛线与手作专门店'
    assign og_default_description = '一团一团，慢慢挑。精选渐变、段染、马海毛、圈圈纱等特色毛线与配好团数的编织包，陪你按自己的节奏享受编织。'
    assign og_default_image_alt = 'hitoami｜窗边木椅上织到一半的编织片与毛线团'
  elsif og_lang_raw == 'en' or og_lang_raw contains 'en-'
    assign og_is_en = true
    assign og_locale = 'en_US'
    assign og_default_title = 'hitoami | Specialty Yarn & Knitting Kits'
    assign og_default_description = 'Choose yarn, one ball at a time. Gradient, variegated, mohair and bouclé yarns alongside project-ready knitting kits from our online yarn shop.'
    assign og_default_image_alt = 'hitoami | A half-knitted cream wool swatch and colorful yarn balls on a sunlit wooden chair'
  endif

  assign og_title = page_title | strip
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | strip

  if request.page_type == 'product'
    assign og_type = 'product'
    if og_title == blank or og_title == 'My Store'
      assign og_title = product.title | strip
    endif
  elsif request.page_type == 'collection' and collection.title != blank
    if og_title == blank or og_title == 'My Store'
      assign og_title = collection.title | strip
    elsif og_is_zh == false
      if og_title contains '毛线与手作' or og_title contains '毛线' or og_title contains '手作'
        if og_is_en
          assign og_title = collection.title | strip | append: ' | hitoami'
        else
          assign og_title = collection.title | strip | append: '｜hitoami'
        endif
      endif
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_title_is_cn_fallback = false
  if og_is_zh == false
    if og_title contains '毛线与手作' or og_title contains '从第一针开始'
      assign og_title_is_cn_fallback = true
    elsif request.page_type == 'index' and og_title contains '毛线'
      assign og_title_is_cn_fallback = true
    endif
  endif

  if og_title == blank or og_title == 'My Store' or og_title_is_cn_fallback
    assign og_title = og_default_title
  elsif request.page_type == 'index' and og_title == og_site_name
    assign og_title = og_default_title
  endif

  assign og_desc_is_cn_fallback = false
  if og_is_zh == false
    if og_description contains '从第一针开始' or og_description contains '毛线与手作' or og_description contains '把毛线'
      assign og_desc_is_cn_fallback = true
    elsif request.page_type == 'index' and og_description contains '毛线'
      assign og_desc_is_cn_fallback = true
    endif
  endif

  if og_description == blank or og_description == 'My Store' or og_description == shop.name or og_description == og_site_name or og_desc_is_cn_fallback
    assign og_description = og_default_description
  endif

  assign og_entity_image = nil
  if request.page_type == 'product' and product.featured_image != blank
    assign og_entity_image = product.featured_image
  elsif request.page_type == 'collection' and collection.image != blank
    assign og_entity_image = collection.image
  elsif request.page_type == 'article' and article.image != blank
    assign og_entity_image = article.image
  elsif request.page_type == 'metaobject' and metaobject.cover.value != blank
    assign og_entity_image = metaobject.cover.value
  endif

  assign og_image_type = ''
  if og_entity_image != blank
    assign og_entity_url = og_entity_image | image_url: width: 1200
    if og_entity_url contains 'http://' or og_entity_url contains 'https://'
      assign og_image_url = og_entity_url
    else
      assign og_image_url = og_entity_url | prepend: 'https:'
    endif
    assign og_image_width = og_entity_image.width | default: og_entity_image.image.width
    assign og_image_height = og_entity_image.height | default: og_entity_image.image.height
    if og_image_width != blank and og_image_height != blank
      if og_image_width > 1200 and og_image_height > 0
        assign og_image_height = og_image_height | times: 1200 | divided_by: og_image_width
        assign og_image_width = 1200
      endif
    endif
    assign og_image_alt = og_entity_image.alt | default: og_entity_image.image.alt | default: og_title | strip
  else
    assign og_default_asset = 'hitoami-og-share.jpg' | asset_url
    if og_default_asset contains 'http://' or og_default_asset contains 'https://'
      assign og_image_url = og_default_asset
    else
      assign og_image_url = og_default_asset | prepend: 'https:'
    endif
    assign og_image_width = 1200
    assign og_image_height = 630
    assign og_image_type = 'image/jpeg'
    assign og_image_alt = og_default_image_alt
  endif
-%}

<meta property="og:site_name" content="{{ og_site_name }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:secure_url" content="{{ og_image_url }}">
{%- if og_image_width != blank and og_image_height != blank -%}
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
{%- endif -%}
{%- if og_image_type != blank -%}
  <meta property="og:image:type" content="{{ og_image_type }}">
{%- endif -%}
{%- if og_image_alt != blank -%}
  <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  {%- assign og_twitter_handle = settings.social_twitter_link | split: 'twitter.com/' | last | split: 'x.com/' | last | split: '?' | first | split: '/' | first | remove_first: '@' -%}
  {%- if og_twitter_handle != blank -%}
    <meta name="twitter:site" content="@{{ og_twitter_handle }}">
  {%- endif -%}
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_image_url }}">
{%- if og_image_alt != blank -%}
  <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
{%- endif -%}
