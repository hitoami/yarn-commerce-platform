{%- comment -%}Mobile and drawer navigation. Menu labels and URLs come from Shopify Navigation.{%- endcomment -%}
<header-drawer data-breakpoint="desktop">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>{{- 'icon-hamburger.svg' | inline_asset_content -}}{{- 'icon-close.svg' | inline_asset_content -}}</span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            {%- comment -%}#258：抽屉先放账户和常用功能，再放逛店菜单；手机页头的账户图标让给了语言按钮。{%- endcomment -%}
            {%- if shop.customer_accounts_enabled -%}
              {%- if customer -%}
                <div class="yarn-drawer-account yarn-drawer-account--in">
                  <a class="yarn-drawer-account__head focus-inset" href="{{ routes.account_url }}">
                    <span class="yarn-drawer-account__avatar" aria-hidden="true">{{- 'icon-account.svg' | inline_asset_content -}}</span>
                    <span class="yarn-drawer-account__text">
                      <b>{{ 'sections.header.drawer_welcome' | t }}</b>
                      <small>{{ 'sections.header.drawer_welcome_note' | t }}</small>
                    </span>
                  </a>
                  <div class="yarn-drawer-account__links">
                    <a class="focus-inset" href="{{ routes.account_url }}">{{ 'sections.header.drawer_orders' | t }}</a>
                    <a class="focus-inset" href="{{ routes.account_addresses_url }}">{{ 'sections.header.drawer_addresses' | t }}</a>
                  </div>
                </div>
              {%- else -%}
                <a class="yarn-drawer-account focus-inset" href="{{ routes.account_login_url }}">
                  <span class="yarn-drawer-account__avatar" aria-hidden="true">{{- 'icon-account.svg' | inline_asset_content -}}</span>
                  <span class="yarn-drawer-account__text">
                    <b>{{ 'sections.header.drawer_login_title' | t }}</b>
                    <small>{{ 'sections.header.drawer_login_note' | t }}</small>
                  </span>
                  <span class="yarn-drawer-account__cta">{{ 'customer.log_in' | t }}</span>
                </a>
              {%- endif -%}
            {%- endif -%}
            <ul class="yarn-drawer-quick list-unstyled" role="list">
              <li><a class="focus-inset" href="{{ routes.search_url }}?browse=favorites"><span class="yarn-drawer-quick__icon" aria-hidden="true">{{- 'icon-heart.svg' | inline_asset_content -}}</span>{{ 'yarn_discovery.favorites' | t }}</a></li>
              {%- if shop.customer_accounts_enabled and customer == nil -%}
                <li><a class="focus-inset" href="{{ routes.account_url }}"><span class="yarn-drawer-quick__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8"/></svg></span>{{ 'sections.header.drawer_orders' | t }}</a></li>
              {%- endif -%}
              {%- if pages['shipping'] != blank -%}
                <li><a class="focus-inset" href="{{ pages['shipping'].url }}"><span class="yarn-drawer-quick__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg></span>{{ 'sections.header.drawer_shipping' | t }}</a></li>
              {%- endif -%}
              {%- if pages['contact'] != blank -%}
                <li><a class="focus-inset" href="{{ pages['contact'].url }}"><span class="yarn-drawer-quick__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/></svg></span>{{ 'sections.header.drawer_contact' | t }}</a></li>
              {%- endif -%}
            </ul>
            <p class="yarn-drawer-heading">{{ 'sections.header.drawer_shop' | t }}</p>
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in navigation_menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-yarn-menu-drawer-item-{{ forloop.index }}">
                      <summary
                        id="YarnHeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                      </summary>
                      <div id="yarn-link-{{ link.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="YarnHeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url | escape }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}aria-current="page"{% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-yarn-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                                    </summary>
                                    <div id="yarn-childlink-{{ childlink.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="YarnHeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url | escape }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}aria-current="page"{% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="YarnHeaderDrawer-{{ link.handle }}"
                      href="{{ link.url | escape }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset yarn-drawer-row{% if link.current %} menu-drawer__menu-item--active{% endif %}{% if link.type == 'collection_link' and link.object.handle == 'sale' %} yarn-menu-sale{% endif %}"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      <span>{{ link.title | escape }}</span>
                      {%- comment -%}#299：手机上毛线行直接进毛线目录，只多一个「N 款」；分类大图面板只留给桌面。{%- endcomment -%}
                      {%- if link.type == 'collection_link' and link.object.handle == section.settings.drawer_yarn_collection.handle and link.object.all_products_count > 0 -%}
                        <span class="yarn-drawer-row__total">{{ 'yarn_project.entry_count' | t: count: link.object.all_products_count }}</span>
                      {%- endif -%}
                      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 -%}
                        <span class="yarn-nav-badge">{{ 'sections.header.coming_soon' | t }}</span>
                      {%- endif -%}
                      <span class="svg-wrapper yarn-drawer-row__arrow" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                    {%- if first_time != blank and link.type == 'collection_link' and link.object.handle == section.settings.drawer_yarn_collection.handle -%}
                      <a class="yarn-drawer-sub focus-inset" href="{{ link.url | escape }}?ycb_beginner=1">{{ 'yarn_collection.first_time' | t }}<span aria-hidden="true"> →</span></a>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          {%- if show_language_selector and localization.available_languages.size > 1 -%}
            {%- comment -%}#258：语言是一行，点开就是页头同一个语言面板（yarn-language-switch）。{%- endcomment -%}
            <button type="button" class="yarn-drawer-language focus-inset" data-lang-open aria-controls="YarnLang">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 3.8 5.8 3.8 9s-1.2 6.2-3.8 9c-2.6-2.8-3.8-5.8-3.8-9S9.4 5.8 12 3z"/></svg>
              <span>{{ 'localization.language_label' | t }}</span>
              <b>{{ localization.language.endonym_name | capitalize }}</b>
              <span class="svg-wrapper yarn-drawer-row__arrow" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>
