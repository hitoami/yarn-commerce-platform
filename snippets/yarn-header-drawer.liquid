{%- comment -%}Mobile and drawer navigation. Menu labels and URLs come from Shopify Navigation.{%- endcomment -%}
{%- liquid
  assign drawer_collection = section.settings.drawer_yarn_collection
  capture drawer_tiles
    for block in section.blocks
      if block.type == 'yarn_entry'
        render 'yarn-drawer-entry', block: block, collection: drawer_collection
      endif
    endfor
  endcapture
  assign drawer_tiles = drawer_tiles | strip
-%}
<header-drawer data-breakpoint="desktop">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>{{- 'icon-hamburger.svg' | inline_asset_content -}}{{- 'icon-close.svg' | inline_asset_content -}}</span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in navigation_menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-yarn-menu-drawer-item-{{ forloop.index }}">
                      <summary
                        id="YarnHeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                      </summary>
                      <div id="yarn-link-{{ link.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="YarnHeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url | escape }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}aria-current="page"{% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-yarn-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                                    </summary>
                                    <div id="yarn-childlink-{{ childlink.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="YarnHeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url | escape }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}aria-current="page"{% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- elsif link.type == 'page_link' and link.object.handle == 'season' -%}
                    {%- comment -%}本季主推：菜单里指向 season 页面的项显示为带图横条（#131 导航手机稿）。{%- endcomment -%}
                    {%- capture season_text -%}{%- render 'yarn-setting-text', settings: section.settings, key: 'drawer_season_text' -%}{%- endcapture -%}
                    <a
                      id="YarnHeaderDrawer-{{ link.handle }}"
                      href="{{ link.url | escape }}"
                      class="yarn-drawer-feature focus-inset"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      <span class="yarn-drawer-feature__media">
                        {%- if section.settings.drawer_season_image != blank -%}
                          {{ section.settings.drawer_season_image | image_url: width: 800 | image_tag: widths: '400, 800', sizes: 'calc(100vw - 32px)', loading: 'lazy', alt: '' }}
                        {%- else -%}
                          <img src="{{ 'hitoami-source-oil-loop.jpeg' | asset_url }}" width="790" height="885" loading="lazy" alt="">
                        {%- endif -%}
                      </span>
                      <span class="yarn-drawer-feature__text">
                        <span class="yarn-drawer-feature__label">{{ link.title | escape }}</span>
                        {%- if season_text != blank -%}<span class="yarn-drawer-feature__title">{{ season_text | escape }}</span>{%- endif -%}
                      </span>
                      <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                    </a>
                  {%- elsif link.type == 'collection_link' and link.object.handle == section.settings.drawer_yarn_collection.handle and drawer_tiles != blank -%}
                    {%- comment -%}毛线：默认展开为分类图块，标题行可收起；图块来自本区块的「毛线入口」block。{%- endcomment -%}
                    <div class="yarn-drawer-yarn" data-drawer-group>
                      <button
                        type="button"
                        id="YarnHeaderDrawer-{{ link.handle }}"
                        class="yarn-drawer-yarn__toggle menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                        aria-expanded="true"
                        aria-controls="YarnDrawerTiles"
                      >
                        <span class="yarn-drawer-yarn__title">{{ link.title | escape }}</span>
                        <span class="yarn-drawer-yarn__total">{{ 'yarn_project.entry_count' | t: count: link.object.all_products_count }}</span>
                        <span class="svg-wrapper yarn-drawer-chevron" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                      </button>
                      <ul class="yarn-drawer-tiles list-unstyled" id="YarnDrawerTiles" role="list">
                        {{ drawer_tiles }}
                        <li>
                          <a class="yarn-drawer-tile yarn-drawer-tile--all" href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>
                            {%- if section.settings.drawer_all_image != blank -%}
                              <span class="yarn-drawer-tile__photo">
                                {{ section.settings.drawer_all_image | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '160px', loading: 'lazy', alt: '' }}
                              </span>
                            {%- else -%}
                              {%- comment -%}未设图片时拼四件商品主图，避免与分类图块重复。{%- endcomment -%}
                              <span class="yarn-drawer-tile__photo yarn-drawer-tile__photo--mosaic">
                                {%- for drawer_product in link.object.products limit: 4 -%}
                                  {%- if drawer_product.featured_image != blank -%}
                                    {{ drawer_product.featured_image | image_url: width: 200 | image_tag: widths: '100, 200', sizes: '80px', loading: 'lazy', alt: '' }}
                                  {%- endif -%}
                                {%- endfor -%}
                              </span>
                            {%- endif -%}
                            <span class="yarn-drawer-tile__name">{{ 'yarn_project.entries_view_all' | t }}</span>
                            <span class="yarn-drawer-tile__count">{{ 'yarn_project.entry_count' | t: count: link.object.all_products_count }}</span>
                          </a>
                        </li>
                      </ul>
                    </div>
                  {%- else -%}
                    <a
                      id="YarnHeaderDrawer-{{ link.handle }}"
                      href="{{ link.url | escape }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset yarn-drawer-row{% if link.current %} menu-drawer__menu-item--active{% endif %}{% if link.type == 'collection_link' and link.object.handle == 'sale' %} yarn-menu-sale{% endif %}"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      <span>{{ link.title | escape }}</span>
                      {%- if link.type == 'collection_link' and link.object.all_products_count == 0 -%}
                        <span class="yarn-drawer-badge">{{ 'sections.header.coming_soon' | t }}</span>
                      {%- endif -%}
                      <span class="svg-wrapper yarn-drawer-row__arrow" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            <div class="yarn-account-drawer">
              <a class="menu-drawer__menu-item yarn-account-drawer-link link link--text focus-inset" href="{{ routes.search_url }}?browse=favorites">
                <span class="svg-wrapper" aria-hidden="true">{{- 'icon-heart.svg' | inline_asset_content -}}</span>
                {{ 'yarn_discovery.favorites' | t }}
              </a>
              {%- if shop.customer_accounts_enabled -%}
                <a class="menu-drawer__menu-item yarn-account-drawer-link link link--text focus-inset" href="{{ routes.account_url }}">
                  <span class="svg-wrapper" aria-hidden="true">{{- 'icon-account.svg' | inline_asset_content -}}</span>
                  {{ 'customer.account.title' | t }}
                </a>
              {%- endif -%}
            </div>
          </nav>
          {%- if show_language_selector and localization.available_languages.size > 1 -%}
            {%- comment -%}All shop languages side by side: one tap opens the same page in that language (#107).{%- endcomment -%}
            {%- liquid
              assign current_language_root = localization.language.root_url
              assign path_without_language = request.path
              if current_language_root != '/'
                assign path_without_language = path_without_language | remove_first: current_language_root
              endif
              if path_without_language == blank
                assign path_without_language = '/'
              endif
            -%}
            <div class="menu-drawer__localization yarn-drawer-language">
              <h2 class="visually-hidden" id="HeaderDrawerLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              <ul class="yarn-drawer-language__list list-unstyled" role="list" aria-labelledby="HeaderDrawerLanguageLabel">
                {%- for language in localization.available_languages -%}
                  {%- liquid
                    assign language_url = language.root_url
                    if path_without_language != '/'
                      if language.root_url == '/'
                        assign language_url = path_without_language
                      else
                        assign language_url = language.root_url | append: path_without_language
                      endif
                    endif
                  -%}
                  <li>
                    <a
                      class="yarn-drawer-language__option"
                      href="{{ language_url }}"
                      hreflang="{{ language.iso_code }}"
                      lang="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}
                        aria-current="true"
                      {% endif %}
                    >
                      {{- language.endonym_name | capitalize -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>
{%- if drawer_tiles != blank -%}
  <script>
    {%- comment -%}毛线标题行收起 / 展开分类图块。不用 details，避免触发 Rise 抽屉的子菜单滑动。{%- endcomment -%}
    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('.yarn-drawer-yarn__toggle');
      if (!toggle) return;
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      document.getElementById(toggle.getAttribute('aria-controls')).hidden = !open;
    });
  </script>
{%- endif -%}
