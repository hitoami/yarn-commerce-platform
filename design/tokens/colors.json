{
  "$comment": "唯一颜色源。修改后运行 npm run tokens 生成 assets/yarn-design-tokens.css 颜色段、config/settings_data.json 的 color_schemes 与 DESIGN.md 颜色 YAML。页面只能引用 roles；palette 只在本文件内被 roles 引用。",
  "palette": {
    "paper": "#fcfbf7",
    "white": "#ffffff",
    "apricot": "#f5e6d2",
    "ink": "#433a31",
    "muted": "#756b60",
    "brand": "#a64b2d",
    "brand-deep": "#8a3d24",
    "ginger": "#d39a58",
    "line": "#e6ded2",
    "disabled": "#8c8378",
    "focus-blue": "#426f82"
  },
  "roles": {
    "home-action": {"value":"brand","use":"陶橘主操作：首页主按钮与毛线详情操作；与固定 Logo 协调"},
    "home-thread": {"value":"ginger","use":"小猫展开的姜橘装饰毛线，不作小字"},
    "home-rope": {"value":"ginger","use":"旧挂线组件的姜橘装饰线；非当前首页默认"},
    "bg-page": {"value":"paper","use":"柔白页面底"},
    "bg-surface": {"value":"white","use":"白色卡片、输入框与 FAQ 面"},
    "bg-sunken": {"value":"apricot","use":"浅橘次级区块与页脚"},
    "bg-warm": {"value":"apricot","use":"浅橘区块（兼容配色方案 5）"},
    "bg-band": {"value":"paper","use":"柔白辅助面板，可承载辅助文字"},
    "bg-inverse": {"value":"brand-deep","use":"深色反白区块"},
    "text-primary": {"value":"ink","use":"暖深灰正文与标题"},
    "text-heading": {"value":"ink","use":"商品标题，复用主文字色"},
    "text-warm": {"value":"ink","use":"浅橘面上的暖深灰文字"},
    "text-secondary": {"value":"ink","use":"次级正文；浅橘面仍用深色保证对比度"},
    "text-muted": {"value":"muted","use":"辅助说明与规格，仅用于白色或柔白底"},
    "text-disabled": {"value":"disabled","use":"不可用文字"},
    "text-inverse": {"value":"white","use":"深色区块上的文字"},
    "text-on-action": {"value":"white","use":"陶土实心按钮上的文字"},
    "text-on-cta": {"value":"ink","use":"浅橘次级按钮上的深色文字"},
    "action": {"value":"brand","use":"陶橘链接与操作"},
    "accent": {"value":"brand","use":"陶橘价格与交易操作，复用主操作色"},
    "action-strong": {"value":"brand-deep","use":"陶橘操作悬停与按下态"},
    "action-subtle-bg": {"value":"paper","use":"浅色操作面：导航选中、帮助"},
    "action-subtle-hover": {"value":"apricot","use":"浅色操作面的悬停"},
    "cta-bg": {"value":"apricot","use":"兼容现有浅色次级按钮与筛选的浅橘面"},
    "cta-hover": {"value":"apricot","use":"浅橘次级按钮悬停面"},
    "cta-border": {"value":"ginger","use":"姜橘装饰边线，不单独承载控件识别"},
    "border-subtle": {"value":"line","use":"分组细线、区块分隔"},
    "border-card": {"value":"line","use":"商品与内容卡片边线"},
    "border-control": {"value":"muted","use":"输入框、筛选与数量控件边线"},
    "border-disabled": {"value":"line","use":"不可用控件边线"},
    "tint-butter": {"value":"apricot","use":"浅橘信息角标；保留组件语义别名"},
    "tint-blush": {"value":"apricot","use":"浅橘信息角标；保留组件语义别名"},
    "tint-sage": {"value":"apricot","use":"浅橘信息角标；保留组件语义别名"},
    "selected-text": {"value":"brand","use":"陶橘选中态文字与描边"},
    "focus": {"value":"focus-blue","use":"键盘焦点环、输入光标（全站唯一冷色）"},
    "decor-thread": {"value":"ginger","use":"插画连线、装饰描边；不得用于文字"},
    "decor-art-line": {"value":"ginger","use":"插画节点描边；不得用于文字"},
    "decor-halo": {"value":"ginger","alpha":0.45,"use":"插画节点光晕"},
    "overlay": {"value":"ink","alpha":0.32,"use":"抽屉与弹窗遮罩、浮层阴影"},
    "shadow-soft": {"value":"ink","alpha":0.14,"use":"卡片与浮层的柔和阴影"},
    "scrollbar-thumb": {"value":"muted","use":"滚动条滑块"},
    "scrollbar-track": {"value":"paper","use":"滚动条轨道"},
    "shadow-page": {"value":"line","use":"配色方案 1 阴影色"},
    "shadow-sunken": {"value":"line","use":"配色方案 2 阴影色"},
    "shadow-inverse": {"value":"brand-deep","use":"配色方案 3 阴影色"},
    "shadow-cream": {"value":"line","use":"配色方案 4 阴影色"},
    "shadow-warm": {"value":"line","use":"配色方案 5 阴影色"}
  },
  "schemes": {
    "scheme-1": {"name":"默认页面","background":"bg-page","text":"text-primary","button":"accent","button_label":"text-on-action","secondary_button_label":"action","shadow":"shadow-page"},
    "scheme-2": {"name":"暖砂次级","background":"bg-sunken","text":"text-primary","button":"accent","button_label":"text-on-action","secondary_button_label":"action","shadow":"shadow-sunken"},
    "scheme-3": {"name":"深色反白","background":"bg-inverse","text":"text-inverse","button":"bg-surface","button_label":"bg-inverse","secondary_button_label":"text-inverse","shadow":"shadow-inverse"},
    "scheme-4": {"name":"柔和奶油","background":"action-subtle-bg","text":"text-primary","button":"accent","button_label":"text-on-action","secondary_button_label":"action","shadow":"shadow-cream"},
    "scheme-5": {"name":"暖米","background":"bg-warm","text":"text-warm","button":"accent","button_label":"text-on-action","secondary_button_label":"action","shadow":"shadow-warm"}
  },
  "contrast": {
    "$comment": "声明实际使用的文字/背景搭配；min 为 WCAG 最低对比度（正文 4.5，大字与控件 3）。",
    "pairs": [
      ["text-inverse","home-action",4.5], ["home-action","bg-surface",4.5], ["home-action","bg-band",4.5],
      ["text-primary","bg-band",4.5], ["text-secondary","bg-band",4.5], ["text-muted","bg-band",4.5],
      ["text-secondary","tint-sage",4.5], ["text-heading","tint-blush",4.5], ["text-primary","bg-page",4.5],
      ["text-primary","bg-surface",4.5], ["text-primary","bg-sunken",4.5], ["text-primary","action-subtle-bg",4.5],
      ["text-primary","tint-butter",4.5], ["text-primary","tint-blush",4.5], ["text-primary","tint-sage",4.5],
      ["text-heading","bg-page",4.5], ["text-heading","bg-surface",4.5], ["text-heading","cta-bg",4.5],
      ["text-warm","bg-warm",4.5], ["text-secondary","bg-page",4.5], ["text-secondary","bg-surface",4.5],
      ["text-muted","bg-page",4.5], ["text-muted","bg-surface",4.5], ["text-muted","action-subtle-bg",4.5],
      ["text-inverse","bg-inverse",4.5], ["text-on-action","accent",4.5], ["text-on-action","action",4.5],
      ["text-on-cta","cta-bg",4.5], ["action","bg-page",4.5], ["action","bg-surface",4.5],
      ["action","action-subtle-bg",4.5], ["accent","bg-page",4.5], ["accent","bg-surface",4.5],
      ["selected-text","bg-surface",4.5], ["border-control","bg-surface",3], ["focus","bg-surface",3],
      ["focus","bg-page",3], ["text-disabled","bg-surface",3]
    ]
  },
  "nearDuplicates": {
    "$comment": "Zen 色板保留白色组件面与柔白页面底的细微层次；其余语义角色复用同一基础色。",
    "minDeltaE": 5,
    "allow": [["paper","white"]]
  }
}
