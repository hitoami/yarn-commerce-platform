# Shopify Admin API (Dev Dashboard app "mewool-admin-readonly"; despite the name it has write scopes, so writes still need --write and approval).
# Copy to .env in the worktree root and fill in.
# Never commit .env; the client secret is in Dev Dashboard → app → Settings.
SHOPIFY_STORE=tutaka-54.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
