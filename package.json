{
  "name": "yarn-commerce-platform",
  "private": true,
  "description": "Shopify storefront and platform workspace for the yarn commerce project",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@shopify/cli": "4.7.1",
    "liquidjs": "10.30.1",
    "playwright-core": "1.63.0"
  },
  "scripts": {
    "dev": "shopify theme dev",
    "favorites": "node services/favorites/server.cjs",
    "admin": "node scripts/shopify-admin.cjs",
    "check": "shopify theme check --path .",
    "verify": "npm run check && npm test",
    "test": "node --test tests/*.test.cjs",
    "shopify": "shopify",
    "tokens": "node scripts/color-tokens.cjs",
    "proof": "npm run verify && node scripts/proof.cjs"
  }
}
